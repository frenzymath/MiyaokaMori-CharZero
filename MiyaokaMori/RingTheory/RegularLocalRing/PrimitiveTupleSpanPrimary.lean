import MiyaokaMori.Prelude
import MiyaokaMori.RingTheory.RegularLocalRing.PrimitiveTuple

/-! # The ideal of a primitive tuple contains a power of the maximal ideal

In a Noetherian local UFD of dimension `≤ 2`, the ideal generated by a nonzero primitive tuple contains some
power of the maximal ideal (its cosupport is only the closed point).

References: Debarre, *Higher-Dimensional Algebraic Geometry*, 5.17 (the indeterminacy of a rational map on a
smooth surface is finitely many points) and the proof of Thm 5.18; Hartshorne II, Prop. 6.2 (UFD ⇔ height-one
primes are principal).
-/

set_option autoImplicit false
set_option maxHeartbeats 400000

universe u v w u' v'

noncomputable section

/-- `A` a Noetherian local domain, a UFD of Krull dimension `≤ 2`; `a : ι → A` primitive and not identically zero.
Then `𝔪ⁿ ≤ (a_i)_i` for some `n`.

Proof: let `J = span(range a)`. If `J = ⊤` take `n = 0`. Otherwise take any prime `P ⊇ J` and show `P = 𝔪`:
`P ≠ ⊥` (it contains some `a_i ≠ 0`). If `P ≠ 𝔪` then `⊥ < P < 𝔪`, and `dim ≤ 2` forces `P` to have height `1`
(otherwise `⊥ < Q < P < 𝔪` would be a chain of primes of length `3`, contradicting `ringKrullDim A ≤ 2`; use the
chain characterization of `Ideal.height`/`Order.krullDim`, or `Ideal.height_add_one_le_of_lt_of_isPrime`,
`Ideal.height_le_ringKrullDim_of_ne_top`). In a UFD a nonzero prime contains a prime element `p`
(`Ideal.IsPrime.exists_mem_prime_of_ne_bot`); `(p)` is a nonzero prime with `(p) ≤ P`, and height `1` gives
`(p) = P`, so `p ∣ a_i` for all `i`, contradicting primitivity. Hence the only minimal prime of `J` is `𝔪`,
`Ideal.radical J = 𝔪` (`Ideal.radical_eq_sInf`), and in a Noetherian ring `Ideal.exists_radical_pow_le_of_fg`
gives `n` with `𝔪ⁿ = (radical J)ⁿ ≤ J`.
Edge cases: `A` a field (`dim 0`): `a_i ≠ 0` is a unit, `J = ⊤`; `dim 1` (DVR): primitive ⇒ some `a_i` is a
unit. -/
theorem exists_maximalIdeal_pow_le_span_of_isPrimitiveTuple
    {A : Type*} [CommRing A] [IsDomain A] [IsNoetherianRing A] [IsLocalRing A]
    [UniqueFactorizationMonoid A] (hdim : ringKrullDim A ≤ 2)
    {ι : Type*} (a : ι → A) (ha0 : ∃ i, a i ≠ 0) (ha : IsPrimitiveTuple a) :
    ∃ n : ℕ, IsLocalRing.maximalIdeal A ^ n ≤ Ideal.span (Set.range a) := by
  set J := Ideal.span (Set.range a) with hJ
  set m := IsLocalRing.maximalIdeal A with hm
  have hmP : m.IsPrime := (IsLocalRing.maximalIdeal.isMaximal A).isPrime
  -- Step 1: every prime `P ⊇ J` is the maximal ideal.
  have key : ∀ P : Ideal A, P.IsPrime → J ≤ P → m ≤ P := by
    intro P hP hJP
    have := hP
    have hPm : P ≤ m := IsLocalRing.le_maximalIdeal hP.ne_top
    by_contra hnot
    have hPlt : P < m := lt_of_le_of_ne hPm (fun h => hnot (h ▸ le_rfl))
    obtain ⟨i, hi⟩ := ha0
    have haiP : a i ∈ P := hJP (Ideal.subset_span (Set.mem_range_self i))
    have hPbot : P ≠ ⊥ := fun h => hi ((Ideal.mem_bot).mp (h ▸ haiP))
    -- a prime element `p ∈ P` (UFD)
    obtain ⟨p, hpP, hp⟩ := hP.exists_mem_prime_of_ne_bot hPbot
    have hp0 : p ≠ 0 := hp.ne_zero
    have hpprime : (Ideal.span {p}).IsPrime := (Ideal.span_singleton_prime hp0).mpr hp
    have hspP : Ideal.span {p} ≤ P := (Ideal.span_singleton_le_iff_mem P).mpr hpP
    -- `(p) = P`, otherwise `⊥ < (p) < P < 𝔪` forces `ht 𝔪 ≥ 3 > 2 ≥ dim A`.
    have hsp_eq : Ideal.span {p} = P := by
      by_contra hne
      have hlt : Ideal.span {p} < P := lt_of_le_of_ne hspP hne
      have hbot : (⊥ : Ideal A) < Ideal.span {p} :=
        bot_lt_iff_ne_bot.mpr (by simpa [Ideal.span_singleton_eq_bot] using hp0)
      have h1 := Ideal.height_add_one_le_of_lt_of_isPrime hbot
      have h2 := Ideal.height_add_one_le_of_lt_of_isPrime hlt
      have h3 := Ideal.height_add_one_le_of_lt_of_isPrime hPlt
      rw [Ideal.height_bot, zero_add] at h1
      have h4 : (3 : ℕ∞) ≤ m.height := by
        calc (3 : ℕ∞) = 1 + 1 + 1 := by norm_num
          _ ≤ (Ideal.span {p}).height + 1 + 1 := by gcongr
          _ ≤ P.height + 1 := by gcongr
          _ ≤ m.height := h3
      have h5 : (m.height : WithBot ℕ∞) ≤ 2 :=
        le_trans Ideal.height_le_ringKrullDim_of_isPrime hdim
      have h6 : ((3 : ℕ∞) : WithBot ℕ∞) ≤ 2 := le_trans (WithBot.coe_le_coe.mpr h4) h5
      norm_num at h6
    -- then `p` divides every coordinate, contradicting primitivity
    obtain ⟨j, hj⟩ := ha p hp
    have hajP : a j ∈ P := hJP (Ideal.subset_span (Set.mem_range_self j))
    rw [← hsp_eq, Ideal.mem_span_singleton] at hajP
    exact hj hajP
  -- Step 2: `𝔪 ≤ radical J`, hence some power of `𝔪` lies in `J` (Noetherian).
  have hrad : m ≤ J.radical := by
    rw [Ideal.radical_eq_sInf]
    exact le_sInf fun P ⟨hJP, hP⟩ => key P hP hJP
  exact Ideal.exists_pow_le_of_le_radical_of_fg hrad (IsNoetherian.noetherian m)

end
