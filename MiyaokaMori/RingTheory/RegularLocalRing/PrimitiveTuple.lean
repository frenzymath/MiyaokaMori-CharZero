import MiyaokaMori.Prelude

/-! # Primitive tuples

The definition of a primitive tuple (a finite tuple in a UFD without a common prime factor), and: in a local
ring, if a finitely generated ideal equals the principal ideal generated by a nonzerodivisor, then after
dividing by that generator some coordinate is a unit.

References: the proof of Debarre, *Higher-Dimensional Algebraic Geometry*, Thm 5.18 (`s_i∘ε = s̃_i·s_E^m`, the
`s̃_i` not all vanishing on `E`); Hartshorne II, Example 7.17.3.
-/

set_option autoImplicit false
set_option maxHeartbeats 400000

universe u v w u' v'

noncomputable section

/-- A primitive tuple: no prime element divides all coordinates (in a UFD, `gcd = 1`).
Note: if `A` is a field there are no prime elements and every tuple (including the zero tuple) is primitive;
where nonvanishing is needed it is a separate hypothesis. -/
def IsPrimitiveTuple {A : Type*} [CommRing A] {ι : Type*} (a : ι → A) : Prop :=
  ∀ p : A, Prime p → ∃ i, ¬ p ∣ a i

/-- In a local ring `B`, if the ideal generated by `(b_i)_i` equals the principal ideal generated by a
nonzerodivisor `d`, then `b_i = d·e_i` with some `e_j` a unit. (The local algebraic form of "the `s̃_i` do not
all vanish on `E`" in the proof of Debarre's Thm 5.18.)
Proof: `d = Σ c_i b_i = d·Σ c_i e_i`, and `d` is a nonzerodivisor ⇒ `Σ c_i e_i = 1`; in a local ring the
nonunits form an ideal, so some `c_j e_j` is a unit. -/
theorem exists_unit_cofactor_of_span_range_eq_span_singleton
    {B : Type*} [CommRing B] [IsLocalRing B] {ι : Type*} [Fintype ι]
    (b : ι → B) (d : B) (hd : ∀ r : B, d * r = 0 → r = 0)
    (h : Ideal.span (Set.range b) = Ideal.span {d}) :
    ∃ e : ι → B, (∀ i, b i = d * e i) ∧ ∃ j, IsUnit (e j) := by
  have hb : ∀ i, ∃ r, b i = d * r := fun i => by
    have hmem : b i ∈ Ideal.span {d} := h ▸ Ideal.subset_span (Set.mem_range_self i)
    obtain ⟨r, hr⟩ := Ideal.mem_span_singleton'.mp hmem
    exact ⟨r, by rw [← hr, mul_comm]⟩
  choose e he using hb
  refine ⟨e, he, ?_⟩
  have hdmem : d ∈ Ideal.span (Set.range b) := h ▸ Ideal.mem_span_singleton_self d
  obtain ⟨c, hc⟩ := (Ideal.mem_span_range_iff_exists_fun).mp hdmem
  have hsum : ∑ i, c i * e i = 1 := by
    have h0 : d * (∑ i, c i * e i - 1) = 0 := by
      rw [mul_sub, mul_one, Finset.mul_sum, sub_eq_zero]
      conv_rhs => rw [← hc]
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [he i]; ring
    exact sub_eq_zero.mp (hd _ h0)
  by_contra hne
  rw [not_exists] at hne
  have hmem : ∑ i, c i * e i ∈ IsLocalRing.maximalIdeal B :=
    Ideal.sum_mem _ fun i _ => Ideal.mul_mem_left _ _
      ((IsLocalRing.mem_maximalIdeal _).mpr (mem_nonunits_iff.mpr (hne i)))
  rw [hsum] at hmem
  exact (IsLocalRing.maximalIdeal.isMaximal B).ne_top ((Ideal.eq_top_iff_one _).mpr hmem)

end
