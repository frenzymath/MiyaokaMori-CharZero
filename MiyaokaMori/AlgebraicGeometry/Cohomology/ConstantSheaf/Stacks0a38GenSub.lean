import MiyaokaMori.Prelude
import MiyaokaMori.AlgebraicGeometry.Cohomology.Vanishing.Stacks02uxAux

/-! # Subsheaves generated by a subfamily of generators

Bookkeeping for the filtration of Stacks 0A38. Given a finite family of morphisms
`ψ i : j_!ℤ_{V i} ⟶ K` (`i : Fin t`) with "weights" `n i : ℕ`, the subsheaf `K_k ⊆ K` generated by the
`ψ i` with `n i ≤ k` is the image of `⨁_{n i ≤ k} j_!ℤ_{V i} ⟶ K` (`genSub ψ n k`). We record:
* `genSubι ψ n k : genSub ψ n k ⟶ K` is a monomorphism;
* `genSubT ψ n k : genSub ψ n k ⟶ genSub ψ n (k+1)` with `genSubT ≫ genSubι = genSubι` (the chain `K_k ⊆ K_{k+1}`);
* `K_0 = 0` when all weights are positive (`isZero_genSub_zero`);
* `K_N = K` as soon as `N` bounds all weights and the `ψ i` generate `K` (`isIso_genSubι_of_le`).

Source: Stacks 0A38 (cohomology-lemma-subsheaf-of-constant-sheaf), third paragraph ("As our filtration
we take `K_0 = 0` and `K_n` generated by the `(U_i, n_i)` with `n_i ≤ n`. It is clear that `K_n = K` for
`n ≫ 0`"). -/

set_option autoImplicit false
set_option maxHeartbeats 400000

universe u

open CategoryTheory CategoryTheory.Limits Opposite TopologicalSpace

noncomputable section

namespace TopCat.Sheaf

-- Mathlib states `Abelian.hasFiniteBiproducts` as a theorem, not an instance; we use it file-locally
-- (no global instance is registered).
attribute [local instance] CategoryTheory.Abelian.hasFiniteBiproducts

variable {X : TopCat.{u}} {K : CategoryTheory.Sheaf (Opens.grothendieckTopology X) AddCommGrpCat.{u}}

/-- the map `⨁_{i : n i ≤ k} j_!ℤ_{V i} ⟶ K` induced by the `ψ i` -/
def genSubDesc {t : ℕ} {V : Fin t → Opens X} (ψ : ∀ i, extendByZeroConstant (V i) ⟶ K)
    (n : Fin t → ℕ) (k : ℕ) :
    (⨁ fun i : {i : Fin t // n i ≤ k} => extendByZeroConstant (V i.1)) ⟶ K :=
  biproduct.desc fun i => ψ i.1

/-- the subsheaf `K_k ⊆ K` generated by the `ψ i` with `n i ≤ k` (as the image of `genSubDesc`) -/
abbrev genSub {t : ℕ} {V : Fin t → Opens X} (ψ : ∀ i, extendByZeroConstant (V i) ⟶ K)
    (n : Fin t → ℕ) (k : ℕ) : CategoryTheory.Sheaf (Opens.grothendieckTopology X) AddCommGrpCat.{u} :=
  image (genSubDesc ψ n k)

/-- the inclusion `K_k ⟶ K` -/
def genSubι {t : ℕ} {V : Fin t → Opens X} (ψ : ∀ i, extendByZeroConstant (V i) ⟶ K)
    (n : Fin t → ℕ) (k : ℕ) : genSub ψ n k ⟶ K :=
  image.ι (genSubDesc ψ n k)

theorem genSubι_mono {t : ℕ} {V : Fin t → Opens X} (ψ : ∀ i, extendByZeroConstant (V i) ⟶ K)
    (n : Fin t → ℕ) (k : ℕ) : Mono (genSubι ψ n k) :=
  inferInstanceAs (Mono (image.ι (genSubDesc ψ n k)))

/-- the generator `ψ i` factors through `K_k` when `n i ≤ k` -/
theorem ι_genSubDesc {t : ℕ} {V : Fin t → Opens X} (ψ : ∀ i, extendByZeroConstant (V i) ⟶ K)
    (n : Fin t → ℕ) (k : ℕ) (i : {i : Fin t // n i ≤ k}) :
    biproduct.ι (fun i : {i : Fin t // n i ≤ k} => extendByZeroConstant (V i.1)) i ≫ genSubDesc ψ n k =
      ψ i.1 := by
  simp [genSubDesc]

/-- inclusion of biproducts along `{i // n i ≤ k} ⊆ {i // n i ≤ k + 1}` -/
def genSubBiprodMap {t : ℕ} (V : Fin t → Opens X) (n : Fin t → ℕ) (k : ℕ) :
    (⨁ fun i : {i : Fin t // n i ≤ k} => extendByZeroConstant (V i.1)) ⟶
      (⨁ fun i : {i : Fin t // n i ≤ k + 1} => extendByZeroConstant (V i.1)) :=
  biproduct.desc fun i =>
    biproduct.ι (fun i : {i : Fin t // n i ≤ k + 1} => extendByZeroConstant (V i.1)) ⟨i.1, Nat.le_succ_of_le i.2⟩

theorem genSubBiprodMap_desc {t : ℕ} {V : Fin t → Opens X} (ψ : ∀ i, extendByZeroConstant (V i) ⟶ K)
    (n : Fin t → ℕ) (k : ℕ) :
    genSubBiprodMap V n k ≫ genSubDesc ψ n (k + 1) = genSubDesc ψ n k := by
  apply biproduct.hom_ext'
  intro i
  simp [genSubBiprodMap, genSubDesc]

/-- the inclusion `K_k ⟶ K_{k+1}` -/
def genSubT {t : ℕ} {V : Fin t → Opens X} (ψ : ∀ i, extendByZeroConstant (V i) ⟶ K)
    (n : Fin t → ℕ) (k : ℕ) : genSub ψ n k ⟶ genSub ψ n (k + 1) :=
  image.lift
    { I := genSub ψ n (k + 1)
      m := genSubι ψ n (k + 1)
      e := genSubBiprodMap V n k ≫ factorThruImage (genSubDesc ψ n (k + 1))
      m_mono := genSubι_mono ψ n (k + 1)
      fac := by
        show (genSubBiprodMap V n k ≫ factorThruImage (genSubDesc ψ n (k + 1))) ≫
          image.ι (genSubDesc ψ n (k + 1)) = genSubDesc ψ n k
        rw [Category.assoc, image.fac]
        exact genSubBiprodMap_desc ψ n k }

theorem genSubT_ι {t : ℕ} {V : Fin t → Opens X} (ψ : ∀ i, extendByZeroConstant (V i) ⟶ K)
    (n : Fin t → ℕ) (k : ℕ) : genSubT ψ n k ≫ genSubι ψ n (k + 1) = genSubι ψ n k :=
  image.lift_fac
    { I := genSub ψ n (k + 1)
      m := genSubι ψ n (k + 1)
      e := genSubBiprodMap V n k ≫ factorThruImage (genSubDesc ψ n (k + 1))
      m_mono := genSubι_mono ψ n (k + 1)
      fac := by
        show (genSubBiprodMap V n k ≫ factorThruImage (genSubDesc ψ n (k + 1))) ≫
          image.ι (genSubDesc ψ n (k + 1)) = genSubDesc ψ n k
        rw [Category.assoc, image.fac]
        exact genSubBiprodMap_desc ψ n k }

/-- `K_0 = 0` when all weights are positive (no generator has weight `≤ 0`) -/
theorem isZero_genSub_zero {t : ℕ} {V : Fin t → Opens X} (ψ : ∀ i, extendByZeroConstant (V i) ⟶ K)
    (n : Fin t → ℕ) (hn : ∀ i, 0 < n i) : IsZero (genSub ψ n 0) := by
  have hempty : IsEmpty {i : Fin t // n i ≤ 0} :=
    ⟨fun i => (Nat.not_succ_le_zero _ ((hn i.1).trans_le i.2)).elim⟩
  have hdesc : genSubDesc ψ n 0 = 0 := by
    apply biproduct.hom_ext'
    intro i
    exact (IsEmpty.false i).elim
  have hι : genSubι ψ n 0 = 0 := image.ι_zero' hdesc
  have := genSubι_mono ψ n 0
  exact IsZero.of_mono_eq_zero (genSubι ψ n 0) hι

/-- `K_N = K` once `N` bounds all weights and the `ψ i` generate `K` -/
theorem isIso_genSubι_of_le {t : ℕ} {V : Fin t → Opens X} (ψ : ∀ i, extendByZeroConstant (V i) ⟶ K)
    (hgen : IsJointlyEpi ψ) (n : Fin t → ℕ) (N : ℕ) (hN : ∀ i, n i ≤ N) : IsIso (genSubι ψ n N) := by
  have hepi : Epi (genSubDesc ψ n N) := by
    refine ⟨fun {T} g h hgh => hgen g h fun i => ?_⟩
    have := congrArg (fun f => biproduct.ι (fun i : {i : Fin t // n i ≤ N} => extendByZeroConstant (V i.1))
      ⟨i, hN i⟩ ≫ f) hgh
    simpa [genSubDesc] using this
  have : Epi (genSubι ψ n N) := by
    rw [genSubι]
    exact epi_of_epi_fac (image.fac (genSubDesc ψ n N))
  have := genSubι_mono ψ n N
  exact isIso_of_mono_of_epi _

end TopCat.Sheaf

end
