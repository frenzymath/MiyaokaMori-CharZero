import MiyaokaMori.Prelude
import MiyaokaMori.AlgebraicGeometry.Cohomology.Vanishing.Stacks02uxAux
import MiyaokaMori.AlgebraicGeometry.Cohomology.ExtendByZero.Stacks02uxExtendByZeroDesc

/-! # Every abelian sheaf is a filtered colimit of finitely generated subsheaves

Every abelian sheaf on a topological space is a filtered colimit of subsheaves generated by finitely many
sections (Stacks 02UX, first paragraph; Stacks Modules §17.4, "sheaves of modules generated by sections").

Source: Stacks 02UX (cohomology-lemma-vanishing-generated-one-section), first paragraph.

Contents:
* Step 0 (`sectionDesc`, `unitSection`, `sectionDesc_unitSection`): a section `s ∈ F(U)` gives
  `φ_s : j_!ℤ_U ⟶ F` with `(φ_s)_U(e_U) = s`, where `e_U ∈ (j_!ℤ_U)(U)` is the image of `1`.
  The morphism `α_s : ℤ_U ⟶ F|_U` is built directly by `sheafifyLift` from the constant presheaf
  (`n ↦ n • s|_{j(W)}`), instead of through `constantSheafAdj` at `⊤`; this avoids identifying `j(⊤)` with `U`.
* Step 1 (`fgMap`, `fgSub`, `fgDiagram`, `fgCoconeNat`): the diagram `A ↦ image(ψ_A)` on `Finset (Σ_U F(U))`,
  taken in `Subobject F` so that the functor laws are `Subobject.ofLE_refl` / `ofLE_comp_ofLE`.
* Steps 2–3 inside the main theorem: `G(A)` is generated by `#A` sections (`factorThruImageSubobject` is epi),
  and `colim G ⟶ F` is mono (AB5: `colim.map_mono'`, `IsGrothendieckAbelian` for `Sh(X)`) and epi
  (every section is hit; `Sheaf.Hom.epi_of_presheaf_epi`), hence an iso (`isIso_of_mono_of_epi`).

Pitfall: the generic instance search for `HasColimitsOfShape J (Sheaf _ AddCommGrpCat)`
(needed for `∐` and `colimit`) exceeds the default typeclass heartbeat limit (20000) and then makes the whole
file time out; the `IsGrothendieckAbelian.{u}` instance is found at once, so `hasColimitsOfShape_sheaf` routes
the colimits through it as a file-local instance. -/

set_option autoImplicit false
set_option maxHeartbeats 400000

universe u

open CategoryTheory CategoryTheory.Limits Opposite TopologicalSpace Topology

noncomputable section

namespace TopCat.Sheaf

variable {X : TopCat.{u}}

/-- Colimits of small shape in `Sh(X)`, obtained through `IsGrothendieckAbelian` (the generic instance
search for `HasColimitsOfShape J (Sheaf _ AddCommGrpCat)` exceeds the typeclass heartbeat limit; see the
module docstring). Used as a file-local instance only. -/
theorem hasColimitsOfShape_sheaf (J : Type u) [Category.{u} J] :
    HasColimitsOfShape J (CategoryTheory.Sheaf (Opens.grothendieckTopology X) AddCommGrpCat.{u}) :=
  haveI : HasColimitsOfSize.{u, u} (CategoryTheory.Sheaf (Opens.grothendieckTopology X) AddCommGrpCat.{u}) :=
    IsGrothendieckAbelian.hasColimits _
  HasColimitsOfSize.has_colimits_of_shape J

attribute [local instance high] hasColimitsOfShape_sheaf

variable (F : CategoryTheory.Sheaf (Opens.grothendieckTopology X) AddCommGrpCat.{u})

/-! ### Step 0: a section `s ∈ F(U)` gives a morphism `φ_s : j_!ℤ_U ⟶ F` with `(φ_s)_U(e_U) = s` -/

section SectionDesc

variable (U : Opens X) (s : F.obj.obj (op U))

/-- `j(W) ≤ U` for every open `W` of `U` (`j : U ↪ X`). -/
theorem isOpenEmbedding_functor_obj_le (W : Opens U) : (Opens.isOpenEmbedding U).functor.obj W ≤ U := by
  rintro x ⟨y, _, rfl⟩
  exact y.2

/-- the constant presheaf on `U` with value `ULift ℤ` (its sheafification is `ℤ_U`) -/
abbrev constZPresheaf : (Opens U)ᵒᵖ ⥤ AddCommGrpCat.{u} :=
  (Functor.const (Opens U)ᵒᵖ).obj (AddCommGrpCat.of (ULift.{u} ℤ))

/-- the presheaf map `ℤ_U^{pre} ⟶ (F|_U).val`, `n ↦ n • s|_{j(W)}` on the open `W` of `U`
(natural because restriction maps of `F` compose and `Opens X` is a thin category) -/
def sectionPresheafHom : constZPresheaf U ⟶ (TopCat.Sheaf.restrict F U).obj where
  app W := AddCommGrpCat.ofHom
    ((zmultiplesHom _ ((F.obj.map (homOfLE (isOpenEmbedding_functor_obj_le U W.unop)).op).hom s)).comp
      AddEquiv.ulift.toAddMonoidHom)
  naturality := by
    intro W W' f
    ext n
    change (n.down • (F.obj.map (homOfLE (isOpenEmbedding_functor_obj_le U W'.unop)).op).hom s) =
      (F.obj.map ((Opens.isOpenEmbedding U).functor.op.map f)).hom
        (n.down • (F.obj.map (homOfLE (isOpenEmbedding_functor_obj_le U W.unop)).op).hom s)
    rw [map_zsmul, map_comp_hom_apply]
    congr 2

/-- `α_s : ℤ_U ⟶ F|_U`, the sheaf map corresponding to `1 ↦ s` (`sheafifyLift` of `sectionPresheafHom`) -/
def sectionHom :
    (constantSheaf (Opens.grothendieckTopology U) AddCommGrpCat.{u}).obj (AddCommGrpCat.of (ULift.{u} ℤ)) ⟶
      TopCat.Sheaf.restrict F U :=
  ⟨sheafifyLift (Opens.grothendieckTopology U) (sectionPresheafHom F U s) (TopCat.Sheaf.restrict F U).property⟩

/-- value of `α_s` on the image of `n ∈ ℤ_U^{pre}(W)`: `n • s|_{j(W)}` -/
theorem sectionHom_app_toSheafify (W : (Opens U)ᵒᵖ) (n : ULift.{u} ℤ) :
    ((sectionHom F U s).hom.app W).hom
        (((toSheafify (Opens.grothendieckTopology U) (constZPresheaf U)).app W).hom n) =
      n.down • (F.obj.map (homOfLE (isOpenEmbedding_functor_obj_le U W.unop)).op).hom s :=
  congrArg (fun g => (g.app W).hom n)
    (toSheafify_sheafifyLift (Opens.grothendieckTopology U) (sectionPresheafHom F U s)
      (TopCat.Sheaf.restrict F U).property)

/-- `φ_s : j_!ℤ_U ⟶ F`, the morphism corresponding to the section `s` (`extendByZeroDesc` of `α_s`) -/
def sectionDesc : extendByZeroConstant U ⟶ F :=
  extendByZeroDesc U (sectionHom F U s)

/-- the section `1` of the presheaf `P` (with `P(U) = ℤ_U(j⁻¹U)`) whose sheafification is `j_!ℤ_U` -/
def unitSectionPre :
    (extendByZeroPresheaf U
      ((constantSheaf (Opens.grothendieckTopology U) AddCommGrpCat.{u}).obj
        (AddCommGrpCat.of (ULift.{u} ℤ)))).obj (op U) :=
  ⟨((toSheafify (Opens.grothendieckTopology U) (constZPresheaf U)).app
      (op ((Opens.map (Opens.inclusion' U)).obj U))).hom ⟨1⟩, by
    unfold extendByZeroSubgroup
    rw [if_pos le_rfl]
    exact AddSubgroup.mem_top _⟩

/-- the canonical section `e_U ∈ (j_!ℤ_U)(U)`, the image of `1` -/
def unitSection : (extendByZeroConstant U).obj.obj (op U) :=
  ((toSheafify (Opens.grothendieckTopology X) (extendByZeroPresheaf U _)).app (op U)).hom
    (unitSectionPre U)

/-- `(φ_s)_U (e_U) = s`: unwind `extendByZeroDesc_val_app_toSheafify`, `extendByZeroDescApp_of_le`,
`sectionHom_app_toSheafify`; the two restriction maps `F(U) → F(j(j⁻¹U)) → F(U)` compose to the identity. -/
theorem sectionDesc_unitSection :
    ((sectionDesc F U s).hom.app (op U)).hom (unitSection U) = s := by
  unfold unitSection sectionDesc
  rw [extendByZeroDesc_val_app_toSheafify, extendByZeroDescApp_of_le U _ (op U) le_rfl]
  have h := sectionHom_app_toSheafify F U s (op ((Opens.map (Opens.inclusion' U)).obj U)) ⟨1⟩
  erw [h]
  rw [one_smul, map_comp_hom_apply]
  have hid : (homOfLE (isOpenEmbedding_functor_obj_le U ((Opens.map (Opens.inclusion' U)).obj U))).op ≫
      (homOfLE (le_functor_map_of_le U U le_rfl)).op = 𝟙 _ :=
    Quiver.Hom.unop_inj (Subsingleton.elim _ _)
  rw [hid, F.obj.map_id]
  rfl

end SectionDesc

/-! ### Step 1: the directed system `A ↦ image(ψ_A)` of finitely generated subsheaves -/

/-- the index set `S = Σ_U F(U)` of all sections over all opens (a `Type u`) -/
abbrev SectionIndex : Type u := Σ U : Opens X, F.obj.obj (op U)

/-- `ψ_A : ⨁_{s ∈ A} j_!ℤ_{U_s} ⟶ F`, the sum of the `φ_s`, `s ∈ A` -/
def fgMap (A : Finset (SectionIndex F)) :
    (∐ fun a : A => extendByZeroConstant a.1.1) ⟶ F :=
  Sigma.desc fun a => sectionDesc F a.1.1 a.1.2

/-- `G(A) := image ψ_A` as a subobject of `F` -/
def fgSub (A : Finset (SectionIndex F)) : Subobject F :=
  imageSubobject (fgMap F A)

/-- `A ⊆ B ⇒ image ψ_A ≤ image ψ_B`, since `ψ_A` factors through `ψ_B` via the inclusion of summands -/
theorem fgSub_mono : Monotone (fgSub F) := by
  intro A B hAB
  refine imageSubobject_le (fgMap F A)
    (Sigma.desc fun a : A => Sigma.ι (fun b : B => extendByZeroConstant b.1.1) ⟨a.1, hAB a.2⟩ ≫
      factorThruImageSubobject (fgMap F B)) ?_
  refine Sigma.hom_ext _ _ fun a => ?_
  simp only [fgSub, fgMap, Sigma.ι_desc_assoc, Category.assoc, Sigma.ι_desc]
  erw [imageSubobject_arrow_comp]
  exact Sigma.ι_desc _ _

/-- the diagram `G : Finset S ⥤ Sh(X)`, `A ↦ image ψ_A`, with transition maps `Subobject.ofLE` -/
def fgDiagram :
    Finset (SectionIndex F) ⥤ CategoryTheory.Sheaf (Opens.grothendieckTopology X) AddCommGrpCat.{u} where
  obj A := Subobject.underlying.obj (fgSub F A)
  map h := Subobject.ofLE _ _ (fgSub_mono F (leOfHom h))
  map_id _ := Subobject.ofLE_refl _
  map_comp _ _ := (Subobject.ofLE_comp_ofLE _ _ _ _ _).symm

/-- the cocone `ι : G ⟶ const F` given by the inclusions `image.ι ψ_A` (each a monomorphism) -/
def fgCoconeNat : fgDiagram F ⟶ (Functor.const (Finset (SectionIndex F))).obj F where
  app A := (fgSub F A).arrow
  naturality _ _ _ := by
    dsimp [fgDiagram]
    rw [Category.comp_id]
    exact Subobject.ofLE_arrow _

/-- the statement of `exists_filtered_colimit_finGenerated`, proved inside the namespace (so that the
file-local colimit instance is in scope); see the docstring of the main theorem for the proof. -/
theorem exists_filtered_colimit_finGenerated_aux :
    ∃ (J : Type u) (_ : CategoryTheory.SmallCategory J) (_ : CategoryTheory.IsFiltered J)
      (G : J ⥤ CategoryTheory.Sheaf (Opens.grothendieckTopology X) AddCommGrpCat.{u}),
      Nonempty (CategoryTheory.Limits.colimit G ≅ F) ∧
      ∀ j, TopCat.Sheaf.FinGenerated (G.obj j) ∧ ∃ ι : G.obj j ⟶ F, CategoryTheory.Mono ι := by
  classical
  have : IsFiltered (Finset (SectionIndex F)) := inferInstance
  refine ⟨Finset (SectionIndex F), inferInstance, inferInstance, fgDiagram F, ⟨?_⟩,
    fun A => ⟨?_, ⟨(fgSub F A).arrow, Subobject.arrow_mono _⟩⟩⟩
  · -- Step 3: the comparison map `c : colim G ⟶ F` is an isomorphism
    let c : colimit (fgDiagram F) ⟶ F := colimit.desc (fgDiagram F) (Cocone.mk F (fgCoconeNat F))
    have hc : ∀ A, colimit.ι (fgDiagram F) A ≫ c = (fgSub F A).arrow := fun A => colimit.ι_desc _ _
    -- (a) mono: AB5 (`Sh(X)` is Grothendieck abelian), filtered colimit of monos into the constant diagram
    have := IsFiltered.isConnected (Finset (SectionIndex F))
    haveI : ∀ A, Mono ((fgCoconeNat F).app A) := fun A => Subobject.arrow_mono (fgSub F A)
    haveI : Mono (fgCoconeNat F) := NatTrans.mono_of_mono_app _
    have hmono : Mono c := colim.map_mono' (fgCoconeNat F) (colimit.isColimit _)
      (isColimitConstCocone (Finset (SectionIndex F)) F) c
      (fun A => (hc A).trans (Category.comp_id _).symm)
    -- (b) epi: every section `s ∈ F(V)` is `(φ_s)_V(e_V)`, hence in the image of `c_V`
    have hepi : Epi c := by
      have : ∀ V, Epi (c.hom.app V) := by
        intro V
        rcases V with ⟨V⟩
        rw [AddCommGrpCat.epi_iff_surjective]
        intro s
        let a : SectionIndex F := ⟨V, s⟩
        let A : Finset (SectionIndex F) := {a}
        have ha : a ∈ A := Finset.mem_singleton_self a
        refine ⟨((colimit.ι (fgDiagram F) A).hom.app (op V)).hom
          (((factorThruImageSubobject (fgMap F A)).hom.app (op V)).hom
            (((Sigma.ι (fun b : A => extendByZeroConstant b.1.1) ⟨a, ha⟩).hom.app (op V)).hom
              (unitSection V))), ?_⟩
        have e1 : ∀ y, (c.hom.app (op V)).hom (((colimit.ι (fgDiagram F) A).hom.app (op V)).hom y) =
            (((fgSub F A).arrow).hom.app (op V)).hom y :=
          fun y => congrArg (fun m => (m.hom.app (op V)).hom y) (hc A)
        have e2 : ∀ z, (((fgSub F A).arrow).hom.app (op V)).hom
              (((factorThruImageSubobject (fgMap F A)).hom.app (op V)).hom z) =
            ((fgMap F A).hom.app (op V)).hom z :=
          fun z => congrArg (fun m => (m.hom.app (op V)).hom z) (imageSubobject_arrow_comp (fgMap F A))
        have e3 : ∀ w, ((fgMap F A).hom.app (op V)).hom
              (((Sigma.ι (fun b : A => extendByZeroConstant b.1.1) ⟨a, ha⟩).hom.app (op V)).hom w) =
            ((sectionDesc F V s).hom.app (op V)).hom w :=
          fun w => congrArg (fun m => (m.hom.app (op V)).hom w)
            (Sigma.ι_desc (fun b : A => sectionDesc F b.1.1 b.1.2) ⟨a, ha⟩)
        exact (e1 _).trans ((e2 _).trans ((e3 _).trans (sectionDesc_unitSection F V s)))
      have : Epi c.hom := NatTrans.epi_of_epi_app _
      exact Sheaf.Hom.epi_of_presheaf_epi _ _ c
    -- (c) mono + epi ⇒ iso in an abelian category
    have : IsIso c := isIso_of_mono_of_epi c
    exact asIso c
  · -- Step 2: `G(A)` is generated by the `#A` sections `Sigma.ι s ≫ factorThruImageSubobject ψ_A`
    refine ⟨A.card, fun i => (A.equivFin.symm i).1.1,
      fun i => Sigma.ι (fun b : A => extendByZeroConstant b.1.1) (A.equivFin.symm i) ≫
        factorThruImageSubobject (fgMap F A), ?_⟩
    intro T g h hgh
    have hall : ∀ b : A, Sigma.ι (fun b : A => extendByZeroConstant b.1.1) b ≫
        (factorThruImageSubobject (fgMap F A) ≫ g) =
        Sigma.ι (fun b : A => extendByZeroConstant b.1.1) b ≫
          (factorThruImageSubobject (fgMap F A) ≫ h) := by
      intro b
      obtain ⟨i, rfl⟩ := A.equivFin.symm.surjective b
      have h1 := hgh i
      dsimp only at h1
      exact (Category.assoc _ _ _).symm.trans (h1.trans (Category.assoc _ _ _))
    exact (cancel_epi (factorThruImageSubobject (fgMap F A))).mp (Sigma.hom_ext _ _ hall)

end TopCat.Sheaf

/-- (Stacks 02UX, first paragraph.) Let `F` be an abelian sheaf on a topological space
`X`. Then there are a small filtered category `J`, a diagram `G : J ⥤ Sh(X)` with `colim G ≅ F`, such that
every `G j` is generated by finitely many sections (`TopCat.Sheaf.FinGenerated`: a jointly epimorphic family
`j_{a!}ℤ_{U_a} ⟶ G j`, `a : Fin r`) and admits a monomorphism `G j ⟶ F`.

**Proof (as formalized; Stacks 02UX first paragraph, "colim_A F_A = F").**

*Step 0 (a section is a morphism out of `j_!ℤ_U`; `TopCat.Sheaf.sectionDesc`).* For an open `U` with inclusion
`j : U ↪ X` and `s ∈ F(U)`, the constant presheaf `ℤ_U^{pre}` on `U` maps to `(F|_U).val`
(`F|_U = TopCat.Sheaf.restrict F U`, `(F|_U)(W) = F(j(W))`) by `n ↦ n • s|_{j(W)}` (natural: restriction maps of
`F` compose, and `Opens X` is thin); `sheafifyLift` gives `α_s : ℤ_U ⟶ F|_U` (`TopCat.Sheaf.sectionHom`), and
`φ_s := extendByZeroDesc U α_s : j_!ℤ_U ⟶ F` (`TopCat.Sheaf.sectionDesc`). Let `e_U ∈ (j_!ℤ_U)(U)` be the image of
`1` under `ℤ_U^{pre}(j⁻¹U) → ℤ_U(j⁻¹U) = P(U) → (j_!ℤ_U)(U)` (`TopCat.Sheaf.unitSection`; `P` is the presheaf
`V ↦ ℤ_U(j⁻¹V)` if `V ⊆ U`, else `0`, whose sheafification is `j_!ℤ_U`). Then `(φ_s)_U(e_U) = s`
(`sectionDesc_unitSection`): by `extendByZeroDesc_val_app_toSheafify` and `extendByZeroDescApp_of_le` it is
`F(j(j⁻¹U)) → F(U)` applied to `(α_s)_{j⁻¹U}(1) = 1 • s|_{j(j⁻¹U)}`, and the two restriction maps
`F(U) → F(j(j⁻¹U)) → F(U)` compose to the identity.

*Step 1 (the directed system; `fgDiagram`).* Let `S := Σ (U : Opens X), F(U)` and `J := Finset S`, a directed
poset under `⊆` (`Finset.isDirected_le`, nonempty), hence a small filtered category
(`isFiltered_of_directed_le_nonempty`). For `A : Finset S` let `ψ_A := Sigma.desc (φ_s)_{s ∈ A} :
∐_{s ∈ A} j_!ℤ_{U_s} ⟶ F` (`fgMap`) and `G(A) := imageSubobject ψ_A : Subobject F` (`fgSub`). For `A ⊆ B`,
`ψ_A` factors through `ψ_B` via the inclusion of summands, so `G(A) ≤ G(B)` (`imageSubobject_le`, `fgSub_mono`);
`Subobject.ofLE` gives the transition maps, with functor laws `Subobject.ofLE_refl` / `ofLE_comp_ofLE`.
The inclusions `ι_A := (G(A)).arrow` (monomorphisms) form a natural transformation `G ⟶ const F`
(`fgCoconeNat`, by `Subobject.ofLE_arrow`).

*Step 2 (`G(A)` is finitely generated).* `G(A)` is generated by the `#A` sections
`Sigma.ι s ≫ factorThruImageSubobject ψ_A`, reindexed along `A ≃ Fin #A` (`Finset.equivFin`):
`factorThruImageSubobject` is an epimorphism (equalizers exist) and the coprojections are jointly epimorphic
(`Sigma.hom_ext`).

*Step 3 (`colim G ≅ F`).* Let `c := colimit.desc` of the cocone `(F, ι)`. (a) `c` is a monomorphism:
`Sh(X)` is Grothendieck abelian (Mathlib instance for `Sheaf J A` with `A = AddCommGrpCat`), so `colim` over
the filtered `J` preserves monomorphisms; `ι : G ⟶ const F` is a monomorphism of functors
(`NatTrans.mono_of_mono_app`), and `c` identifies with `colim.map ι` followed by `colim (const F) ≅ F`
(`isColimitConstCocone`, `J` connected because filtered); Mathlib's `colim.map_mono'` packages this.
(b) `c` is an epimorphism: for `s ∈ F(V)` and `A = {(V, s)}`, `s = (φ_s)_V(e_V)` (Step 0), and
`φ_s = Sigma.ι ≫ factorThruImageSubobject ψ_A ≫ ι_A = Sigma.ι ≫ factorThruImageSubobject ψ_A ≫ colimit.ι A ≫ c`,
so `s` is in the image of `c_V`; hence `c.val` is surjective on every open (`AddCommGrpCat.epi_iff_surjective`),
an epimorphism of presheaves (`NatTrans.epi_of_epi_app`), and `c` is an epimorphism of sheaves
(`Sheaf.Hom.epi_of_presheaf_epi`). (c) Mono + epi in an abelian category is an isomorphism
(`isIso_of_mono_of_epi`); `asIso c : colimit G ≅ F`.

**Edge cases.** `X = ∅`: `S` has one element per open, all sections `0`; every `G(A) = 0`, `F = 0`, fine.
`F = 0`: all `φ_s = 0`, `G(A) = 0`, `colim = 0`. Only Prop is asserted; no data leaves this lemma. -/
theorem TopCat.Sheaf.exists_filtered_colimit_finGenerated {X : TopCat.{u}}
    (F : CategoryTheory.Sheaf (Opens.grothendieckTopology X) AddCommGrpCat.{u}) :
    ∃ (J : Type u) (_ : CategoryTheory.SmallCategory J) (_ : CategoryTheory.IsFiltered J)
      (G : J ⥤ CategoryTheory.Sheaf (Opens.grothendieckTopology X) AddCommGrpCat.{u}),
      Nonempty (CategoryTheory.Limits.colimit G ≅ F) ∧
      ∀ j, TopCat.Sheaf.FinGenerated (G.obj j) ∧ ∃ ι : G.obj j ⟶ F, CategoryTheory.Mono ι :=
  TopCat.Sheaf.exists_filtered_colimit_finGenerated_aux F

end
