import MiyaokaMori.Prelude
import Mathlib.RingTheory.LocalProperties.Basic
import MiyaokaMori.AlgebraicGeometry.Divisors.Effective.EffectiveCartierDivisorScheme
import MiyaokaMori.AlgebraicGeometry.Modules.IdealSheaf.IdealSheafStalkIdealBasic
import MiyaokaMori.AlgebraicGeometry.Modules.IdealSheaf.IdealSheafStalkIdealEqMapGerm
import MiyaokaMori.AlgebraicGeometry.Modules.IdealSheaf.Stacks0ahhComapMul

/-! # Powers and cancellation of invertible ideal sheaves

General facts about invertible ideal sheaves (`MiyaokaMori.Statement.IsInvertibleIdeal`: locally
generated by a nonzerodivisor) and stalk ideals, used by the globalization of Stacks 0AGT
(`exists_pointBlowup_improve`):

* powers of an invertible ideal sheaf are invertible (`isInvertibleIdeal_pow`);
* an invertible ideal sheaf can be cancelled in products, affine-open by affine-open
  (`eq_of_pow_mul_eq_pow_mul`);
* stalk ideals of powers (`stalkIdeal_pow`), monotonicity (`stalkIdeal_mono`), and the stalk
  criterion for inclusion of ideal sheaves (`le_of_forall_stalkIdeal_le`).

Source: Stacks 01WR (invertible ideal sheaves), Stacks 0AGT proof (uniqueness of `I'`), Stacks 00HN
(inclusion of ideals is local at maximal ideals).
-/

set_option autoImplicit false
set_option maxHeartbeats 400000

universe u v w u' v'

open CategoryTheory CategoryTheory.Limits Opposite TopologicalSpace
open scoped AlgebraicGeometry

noncomputable section

namespace AlgebraicGeometry.Scheme.IdealSheafData

/-- Powers of a nonzerodivisor (in the elementwise form used by `IsInvertibleIdeal`) are
nonzerodivisors. -/
theorem pow_mul_eq_zero_imp {R : Type*} [CommRing R] {a : R} (ha : ∀ r : R, a * r = 0 → r = 0)
    (d : ℕ) : ∀ r : R, a ^ d * r = 0 → r = 0 := by
  induction d with
  | zero => intro r hr; simpa using hr
  | succ n ih =>
    intro r hr
    apply ha
    apply ih
    have : a ^ n * (a * r) = a ^ (n + 1) * r := by rw [pow_succ, mul_assoc]
    rw [this, hr]

/-- Powers of an invertible ideal sheaf are invertible: on an affine open where `E(U) = (a)` with
`a` a nonzerodivisor, `(E^d)(U) = E(U)^d = (a^d)` and `a^d` is a nonzerodivisor. -/
theorem isInvertibleIdeal_pow {X : AlgebraicGeometry.Scheme.{u}} {E : X.IdealSheafData}
    (hE : MiyaokaMori.Statement.IsInvertibleIdeal E) (d : ℕ) :
    MiyaokaMori.Statement.IsInvertibleIdeal (E ^ d) := by
  intro x
  obtain ⟨U, hxU, a, ha, hEU⟩ := hE x
  refine ⟨U, hxU, a ^ d, pow_mul_eq_zero_imp ha d, ?_⟩
  rw [ideal_pow, Pi.pow_apply, hEU, Ideal.span_singleton_pow]

/-- Cancellation of a power of an invertible ideal sheaf: if `E^d · K₁ = E^d · K₂` on every affine
open, then `K₁ = K₂`. On an affine open `U` with `E(U) = (a)`, `a` a nonzerodivisor, the equality
`(a^d) K₁(U) = (a^d) K₂(U)` gives for `r ∈ K₁(U)` some `z ∈ K₂(U)` with `a^d z = a^d r`, hence
`z = r`; the opens `U` cover `X`, so `ext_of_iSup_eq_top` applies. -/
theorem eq_of_pow_mul_eq_pow_mul {X : AlgebraicGeometry.Scheme.{u}} {E : X.IdealSheafData}
    (hE : MiyaokaMori.Statement.IsInvertibleIdeal E) (d : ℕ) {K₁ K₂ : X.IdealSheafData}
    (h : ∀ U : X.affineOpens, E.ideal U ^ d * K₁.ideal U = E.ideal U ^ d * K₂.ideal U) :
    K₁ = K₂ := by
  choose U hxU a ha hEU using hE
  refine ext_of_iSup_eq_top U ?_ ?_
  · rw [eq_top_iff]
    intro x _
    exact Opens.mem_iSup.mpr ⟨x, hxU x⟩
  · intro x
    have key : ∀ K₁ K₂ : X.IdealSheafData,
        E.ideal (U x) ^ d * K₁.ideal (U x) = E.ideal (U x) ^ d * K₂.ideal (U x) →
        K₁.ideal (U x) ≤ K₂.ideal (U x) := by
      intro K₁ K₂ h r hr
      have hmem : a x ^ d * r ∈ E.ideal (U x) ^ d * K₂.ideal (U x) := by
        rw [← h, hEU x, Ideal.span_singleton_pow]
        exact Ideal.mul_mem_mul (Ideal.mem_span_singleton_self _) hr
      rw [hEU x, Ideal.span_singleton_pow, Ideal.mem_span_singleton_mul] at hmem
      obtain ⟨z, hz, hzr⟩ := hmem
      have h0 : a x ^ d * (z - r) = 0 := by rw [mul_sub, hzr, sub_self]
      have hzr' : z = r := sub_eq_zero.mp (pow_mul_eq_zero_imp (ha x) d _ h0)
      exact hzr' ▸ hz
    exact le_antisymm (key K₁ K₂ (h (U x))) (key K₂ K₁ (h (U x)).symm)

/-- Stalk ideal of a power. -/
theorem stalkIdeal_pow {X : AlgebraicGeometry.Scheme.{u}} (E : X.IdealSheafData) (d : ℕ)
    (x : X) : (E ^ d).stalkIdeal x = E.stalkIdeal x ^ d := by
  induction d with
  | zero => rw [pow_zero, pow_zero, one_eq_top, stalkIdeal_top, Ideal.one_eq_top]
  | succ n ih => rw [pow_succ, pow_succ, stalkIdeal_mul, ih]

/-- Pullback of a power of an ideal sheaf (from `comap_mul`). -/
theorem comap_pow {X Y : AlgebraicGeometry.Scheme.{u}} (E : Y.IdealSheafData) (f : X ⟶ Y) (d : ℕ) :
    (E ^ d).comap f = (E.comap f) ^ d := by
  induction d with
  | zero => rw [pow_zero, pow_zero, one_eq_top, one_eq_top, comap_top]
  | succ n ih => rw [pow_succ, pow_succ, comap_mul, ih]

/-- Stalk ideals are monotone in the ideal sheaf (directly from the definition as a supremum of
extensions along germ maps). -/
theorem stalkIdeal_mono {X : AlgebraicGeometry.Scheme.{u}} {I J : X.IdealSheafData} (h : I ≤ J)
    (x : X) : I.stalkIdeal x ≤ J.stalkIdeal x := by
  unfold stalkIdeal
  exact iSup₂_mono fun U _ => Ideal.map_mono (h U)

/-- Stalk criterion for inclusion of ideal sheaves: `I ≤ J` as soon as `I_x ≤ J_x` for every point.

Proof: on an affine open `V`, inclusion of ideals of `Γ(V)` can be checked after localization at
every maximal ideal `P` (`Ideal.le_of_localization_maximal`). The point `y := fromSpec P ∈ V` has
`primeIdealOf y = P`, so the stalk `O_{X,y}` is the localization of `Γ(V)` at `P`
(`IsAffineOpen.isLocalization_stalk`), and `I_y = I(V)·O_{X,y}` (`stalkIdeal_eq_map_germ`); the
hypothesis at `y` is transported to `Localization.AtPrime P` along `IsLocalization.algEquiv`. -/
theorem le_of_forall_stalkIdeal_le {X : AlgebraicGeometry.Scheme.{u}} {I J : X.IdealSheafData}
    (h : ∀ x : X, I.stalkIdeal x ≤ J.stalkIdeal x) : I ≤ J := by
  intro V
  have hV : AlgebraicGeometry.IsAffineOpen V.1 := V.2
  refine Ideal.le_of_localization_maximal fun P hP => ?_
  let p : PrimeSpectrum Γ(X, V) := ⟨P, hP.isPrime⟩
  have hyV : hV.fromSpec p ∈ V.1 := by
    have : hV.fromSpec p ∈ Set.range hV.fromSpec := Set.mem_range_self p
    rwa [hV.range_fromSpec] at this
  have hprime : hV.primeIdealOf ⟨_, hyV⟩ = p := by
    apply hV.fromSpec.isOpenEmbedding.injective
    exact hV.fromSpec_primeIdealOf ⟨_, hyV⟩
  let _inst := X.presheaf.algebra_section_stalk ⟨_, hyV⟩
  have hloc : IsLocalization.AtPrime (X.presheaf.stalk (hV.fromSpec p)) P := by
    have := hV.isLocalization_stalk ⟨_, hyV⟩
    rwa [hprime] at this
  have hx := h (hV.fromSpec p)
  rw [stalkIdeal_eq_map_germ I _ V hyV, stalkIdeal_eq_map_germ J _ V hyV] at hx
  let e := IsLocalization.algEquiv P.primeCompl (X.presheaf.stalk (hV.fromSpec p))
    (Localization.AtPrime P)
  have hcomp : (e : X.presheaf.stalk (hV.fromSpec p) →+* Localization.AtPrime P).comp
      (X.presheaf.germ V.1 _ hyV).hom = algebraMap Γ(X, V) (Localization.AtPrime P) :=
    RingHom.ext fun r => e.commutes r
  have := Ideal.map_mono (f := (e : X.presheaf.stalk (hV.fromSpec p) →+* Localization.AtPrime P)) hx
  rwa [Ideal.map_map, Ideal.map_map, hcomp] at this

end AlgebraicGeometry.Scheme.IdealSheafData

end
