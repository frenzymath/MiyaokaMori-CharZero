import MiyaokaMori.Prelude
import MiyaokaMori.AlgebraicGeometry.Proj.Twist.TwistPowerIsoSectionsGeneration

/-! # The section ring of a graded algebra generated in degree one, on affine opens

Sheaf-level "generated in degree one" (`GradedQCAlgebra.GeneratedInDegreeOne`) implies that on an affine
open `U` the section ring `A(U) = ⊕_m Γ(U, 𝒜_m)` satisfies `A(U)_+ ⊆ (A(U)_1)`, i.e. `A(U)` is generated
over `A(U)_0` by `A(U)_1`. This is the algebraic fact needed to reduce the first paragraph of Stacks 01O4
("over affine opens of `S`") to the absolute case (from it, Mathlib's `Proj.iSup_basicOpen_eq_top` gives
that the `D₊(f)`, `f ∈ A(U)_1`, cover `Proj A(U)`).

The proof is the localization argument of `TwistPowerIsoSectionsGeneration` for the Veronese subalgebra
(`GenAux.exists_tensor_unit_app_eq_map`, `mulPowOne_succ_app'`, `exists_pow_mul_eq_restrict_ofPiece`,
`exists_pow_mul_eq_zero_of_restrict_eq_zero` hold there for general `S` and are reused), with the closure
`Subring.closure (A_0 ∪ A_m)` replaced by the ideal `span (A(W)_1)`. No induction on `ℓ` is needed: the value
of `mulPowOne (ℓ+1)` on a pure tensor `a ⊗ b` (`b ∈ Γ(W, 𝒜_1)`) is `(mulPowOne ℓ a) · b`, which in the section
ring is `ofPiece (mulPowOne ℓ a) * ofPiece b ∈ (A(W)_1)` whatever `a` is.

Reference: Stacks 01O4.
-/

set_option autoImplicit false
set_option maxHeartbeats 400000

universe u v w u' v'

open CategoryTheory CategoryTheory.Limits Opposite TopologicalSpace
open scoped AlgebraicGeometry
open scoped CategoryTheory.MonoidalCategory TensorProduct

noncomputable section

namespace AlgebraicGeometry.Scheme.GradedQCAlgebra

variable {X : AlgebraicGeometry.Scheme.{u}} (S : X.GradedQCAlgebra)

/-- The ideal `(A(W)_1)` of the section ring `A(W)` generated by the degree-one part `A(W)_1`. -/
abbrev sectionsDegOneIdeal (W : X.Opens) : Ideal (S.sectionsRing W) :=
  Ideal.span ((S.sectionsGrading W 1 : AddSubgroup (S.sectionsRing W)) : Set (S.sectionsRing W))

/-- Degree-one sections lie in the ideal `(A(W)_1)`. -/
theorem ofPiece_one_mem_sectionsDegOneIdeal (W : X.Opens) (b : S.sectionsPiece W 1) :
    S.ofPiece W 1 b ∈ S.sectionsDegOneIdeal W :=
  Ideal.subset_span ⟨b, rfl⟩

/-- Restriction sends `(A(V)_1)` into `(A(U)_1)` (restriction is a graded ring homomorphism,
`sectionsRestrict.map_mem`). -/
theorem sectionsRestrictHom_mem_sectionsDegOneIdeal {U V : X.Opens} (h : U ≤ V)
    {x : S.sectionsRing V} (hx : x ∈ S.sectionsDegOneIdeal V) :
    S.sectionsRestrictHom h x ∈ S.sectionsDegOneIdeal U := by
  have h1 := Ideal.mem_map_of_mem (S.sectionsRestrictHom h) hx
  rw [Ideal.map_span] at h1
  refine Ideal.span_mono ?_ h1
  rintro y ⟨z, hz, rfl⟩
  exact (S.sectionsRestrict h).map_mem hz

/-! ## Local ideal predicates (the ideal version of `InCl`/`Good`) -/

/-- The image of the section `y` under `mulPowOne ℓ`, placed in the section ring, lies in `(A(W)_1)`. -/
def InDegOne (ℓ : ℕ) (W : X.Opens)
    (y : Γ(AlgebraicGeometry.Scheme.Modules.tensorPow (S.part 1) ℓ, W)) : Prop :=
  S.ofPiece W ℓ ((S.mulPowOne ℓ).app W y) ∈ S.sectionsDegOneIdeal W

/-- `InDegOne` holds near every point. -/
def GoodDegOne (ℓ : ℕ) (W : X.Opens)
    (y : Γ(AlgebraicGeometry.Scheme.Modules.tensorPow (S.part 1) ℓ, W)) : Prop :=
  ∀ p ∈ W, ∃ (W' : X.Opens) (h : W' ≤ W), p ∈ W' ∧
    S.InDegOne ℓ W' ((AlgebraicGeometry.Scheme.Modules.tensorPow (S.part 1) ℓ).presheaf.map
      (homOfLE h).op y)

variable {S}

theorem InDegOne.restrict {ℓ : ℕ} {W : X.Opens}
    {y : Γ(AlgebraicGeometry.Scheme.Modules.tensorPow (S.part 1) ℓ, W)}
    (hy : S.InDegOne ℓ W y) {W₀ : X.Opens} (h : W₀ ≤ W) :
    S.InDegOne ℓ W₀ ((AlgebraicGeometry.Scheme.Modules.tensorPow (S.part 1) ℓ).presheaf.map
      (homOfLE h).op y) := by
  unfold InDegOne at hy ⊢
  rw [GenAux.app_map_res]
  have e : S.ofPiece W₀ ℓ ((S.part ℓ).presheaf.map (homOfLE h).op ((S.mulPowOne ℓ).app W y))
      = S.sectionsRestrictHom h (S.ofPiece W ℓ ((S.mulPowOne ℓ).app W y)) :=
    (S.sectionsRestrictHom_ofPiece h ℓ _).symm
  rw [e]
  exact S.sectionsRestrictHom_mem_sectionsDegOneIdeal h hy

theorem InDegOne.zero (S : X.GradedQCAlgebra) (ℓ : ℕ) (W : X.Opens) : S.InDegOne ℓ W 0 := by
  unfold InDegOne
  refine Set.mem_of_eq_of_mem ?_ (Ideal.zero_mem _)
  exact (congrArg (S.ofPiece W ℓ)
    (map_zero (ConcreteCategory.hom ((S.mulPowOne ℓ).app W)))).trans
    (map_zero (DirectSum.of (S.sectionsPiece W) ℓ))

theorem InDegOne.add {ℓ : ℕ} {W : X.Opens}
    {y₁ y₂ : Γ(AlgebraicGeometry.Scheme.Modules.tensorPow (S.part 1) ℓ, W)}
    (h₁ : S.InDegOne ℓ W y₁) (h₂ : S.InDegOne ℓ W y₂) : S.InDegOne ℓ W (y₁ + y₂) := by
  unfold InDegOne at h₁ h₂ ⊢
  refine Set.mem_of_eq_of_mem ?_ (Ideal.add_mem _ h₁ h₂)
  exact (congrArg (S.ofPiece W ℓ)
    (map_add (ConcreteCategory.hom ((S.mulPowOne ℓ).app W)) y₁ y₂)).trans
    (map_add (DirectSum.of (S.sectionsPiece W) ℓ) _ _)

theorem GoodDegOne.of_inDegOne {ℓ : ℕ} {W : X.Opens}
    {y : Γ(AlgebraicGeometry.Scheme.Modules.tensorPow (S.part 1) ℓ, W)}
    (hy : S.InDegOne ℓ W y) : S.GoodDegOne ℓ W y :=
  fun _ hp => ⟨W, le_rfl, hp, hy.restrict le_rfl⟩

theorem GoodDegOne.zero (S : X.GradedQCAlgebra) (ℓ : ℕ) (W : X.Opens) : S.GoodDegOne ℓ W 0 :=
  GoodDegOne.of_inDegOne (InDegOne.zero S ℓ W)

theorem GoodDegOne.add {ℓ : ℕ} {W : X.Opens}
    {y₁ y₂ : Γ(AlgebraicGeometry.Scheme.Modules.tensorPow (S.part 1) ℓ, W)}
    (h₁ : S.GoodDegOne ℓ W y₁) (h₂ : S.GoodDegOne ℓ W y₂) : S.GoodDegOne ℓ W (y₁ + y₂) := by
  intro p hp
  obtain ⟨W₁, hW₁, hp₁, hIn₁⟩ := h₁ p hp
  obtain ⟨W₂, hW₂, hp₂, hIn₂⟩ := h₂ p hp
  refine ⟨W₁ ⊓ W₂, inf_le_left.trans hW₁, ⟨hp₁, hp₂⟩, ?_⟩
  rw [map_add]
  have e₁ := hIn₁.restrict (W₀ := W₁ ⊓ W₂) inf_le_left
  have e₂ := hIn₂.restrict (W₀ := W₁ ⊓ W₂) inf_le_right
  rw [GenAux.map_map_res] at e₁ e₂
  exact e₁.add e₂

variable (S)

/-- For a pure tensor `a ⊗ b` (`b ∈ Γ(W, 𝒜_1)`): the value of `mulPowOne (ℓ+1)` is `(mulPowOne ℓ a) · b`,
which in the section ring is `ofPiece (mulPowOne ℓ a) * ofPiece b`, an element of the ideal `(A(W)_1)` —
**with no assumption on `a`**. -/
theorem inDegOne_succ_tmul (ℓ : ℕ) (W : X.Opens)
    (a : Γ(AlgebraicGeometry.Scheme.Modules.tensorPow (S.part 1) ℓ, W)) (b : Γ(S.part 1, W)) :
    S.InDegOne (ℓ + 1) W ((AlgebraicGeometry.Scheme.Modules.tensorIsoTensorObj
        (AlgebraicGeometry.Scheme.Modules.tensorPow (S.part 1) ℓ) (S.part 1)).inv.app W
      (AlgebraicGeometry.Scheme.Modules.tensorSections
        (AlgebraicGeometry.Scheme.Modules.tensorPow (S.part 1) ℓ) (S.part 1) W a b)) := by
  unfold InDegOne
  rw [S.mulPowOne_succ_app' ℓ W a b]
  have e : S.ofPiece W (ℓ + 1) ((S.mul ℓ 1).app W
        (AlgebraicGeometry.Scheme.Modules.tensorSections (S.part ℓ) (S.part 1) W
          ((S.mulPowOne ℓ).app W a) b))
      = S.ofPiece W ℓ ((S.mulPowOne ℓ).app W a) * S.ofPiece W 1 b :=
    (DirectSum.of_mul_of (A := S.sectionsPiece W) ((S.mulPowOne ℓ).app W a) b).symm
  rw [e]
  exact Ideal.mul_mem_left _ _ (S.ofPiece_one_mem_sectionsDegOneIdeal W b)

/-- Every section of `tensorPow (𝒜_1) (ℓ+1)` satisfies `GoodDegOne (ℓ+1)`: sections locally come from the
presheaf tensor product (the sheafification unit is locally surjective, `GenAux.exists_tensor_unit_app_eq_map`);
use `inDegOne_succ_tmul` on pure tensors and `GoodDegOne.add` on sums. -/
theorem goodDegOne_succ (ℓ : ℕ) (W : X.Opens)
    (y : Γ(AlgebraicGeometry.Scheme.Modules.tensorPow (S.part 1) (ℓ + 1), W)) :
    S.GoodDegOne (ℓ + 1) W y := by
  intro p hp
  obtain ⟨V, hVW, hpV, z, hz⟩ := GenAux.exists_tensor_unit_app_eq_map
    (AlgebraicGeometry.Scheme.Modules.tensorPow (S.part 1) ℓ) (S.part 1) W y p hp
  have key : ∀ z, S.GoodDegOne (ℓ + 1) V
      (((_root_.PresheafOfModules.sheafificationAdjunction (𝟙 X.ringCatSheaf.obj)).unit.app
        (CategoryTheory.MonoidalCategoryStruct.tensorObj
          ((SheafOfModules.forget X.ringCatSheaf ⋙
            _root_.PresheafOfModules.restrictScalars (𝟙 X.ringCatSheaf.obj)).obj
              (AlgebraicGeometry.Scheme.Modules.tensorPow (S.part 1) ℓ))
          ((SheafOfModules.forget X.ringCatSheaf ⋙
            _root_.PresheafOfModules.restrictScalars (𝟙 X.ringCatSheaf.obj)).obj
              (S.part 1)))).app (op V) z) := by
    intro z
    induction z using TensorProduct.induction_on with
    | zero =>
      exact (congrArg (S.GoodDegOne (ℓ + 1) V) (map_zero _)).mpr (GoodDegOne.zero S (ℓ + 1) V)
    | tmul a b =>
      exact (congrArg (S.GoodDegOne (ℓ + 1) V)
        (AlgebraicGeometry.Scheme.Modules.tensorToSheafify_tensorSections _ _ V a b)).mp
        (GoodDegOne.of_inDegOne (S.inDegOne_succ_tmul ℓ V a b))
    | add z₁ z₂ h₁ h₂ =>
      exact (congrArg (S.GoodDegOne (ℓ + 1) V) (map_add _ z₁ z₂)).mpr (h₁.add h₂)
  have hk := key z
  rw [hz] at hk
  have hk' : S.GoodDegOne (ℓ + 1) V
      ((AlgebraicGeometry.Scheme.Modules.tensorPow (S.part 1) (ℓ + 1)).presheaf.map
        (homOfLE hVW).op y) := hk
  obtain ⟨W', hW', hpW', hIn⟩ := hk' p hpV
  refine ⟨W', hW'.trans hVW, hpW', ?_⟩
  rw [GenAux.map_map_res] at hIn
  exact hIn

/-! ## Localization: from `D(f)` back to the affine open `U` -/

/-- Every element of the section ring `A(D f)`, multiplied by some power of `f`, comes from `A(U)`: induction
on the direct sum decomposition, using `exists_pow_mul_eq_restrict_ofPiece` on each piece (each piece is
quasi-coherent). -/
theorem exists_pow_mul_eq_restrict_sectionsRing {U : X.Opens} (hU : AlgebraicGeometry.IsAffineOpen U)
    (f : Γ(X, U)) (c : S.sectionsRing (X.basicOpen f)) :
    ∃ (n : ℕ) (c' : S.sectionsRing U),
      S.sectionsRestrictHom (X.basicOpen_le f) c' =
        S.sectionsUnitHom (X.basicOpen f) (X.presheaf.map (homOfLE (X.basicOpen_le f)).op f) ^ n * c := by
  have hres : S.sectionsRestrictHom (X.basicOpen_le f) (S.sectionsUnitHom U f) =
      S.sectionsUnitHom (X.basicOpen f) (X.presheaf.map (homOfLE (X.basicOpen_le f)).op f) :=
    S.sectionsUnitHom_naturality (X.basicOpen_le f) f
  refine DirectSum.induction_on (β := S.sectionsPiece (X.basicOpen f))
    (motive := fun (c : S.sectionsRing (X.basicOpen f)) => ∃ (n : ℕ) (c' : S.sectionsRing U),
      S.sectionsRestrictHom (X.basicOpen_le f) c' =
        S.sectionsUnitHom (X.basicOpen f) (X.presheaf.map (homOfLE (X.basicOpen_le f)).op f) ^ n * c)
    c ?_ ?_ ?_
  · -- this `0` is the zero of the direct sum (from `DirectSum.induction_on`), definitionally the zero of the
    -- section ring; close with `exact`
    exact ⟨0, 0, by rw [map_zero]; exact (mul_zero _).symm⟩
  · intro j t
    obtain ⟨n, t', ht'⟩ := S.exists_pow_mul_eq_restrict_ofPiece hU f j t
    exact ⟨n, S.ofPiece U j t', ht'⟩
  · rintro x y ⟨n₁, w₁, e₁⟩ ⟨n₂, w₂, e₂⟩
    refine ⟨n₁ + n₂, S.sectionsUnitHom U f ^ n₂ * w₁ + S.sectionsUnitHom U f ^ n₁ * w₂, ?_⟩
    rw [map_add, map_mul, map_mul, map_pow, map_pow, hres, e₁, e₂]
    -- inside `DirectSum.induction_on`, `x`, `y` carry the direct sum type and `ring` fails directly; prove the
    -- identity in the section ring first, then `exact`
    have key : ∀ (x y : S.sectionsRing (X.basicOpen f)),
        S.sectionsUnitHom (X.basicOpen f) (X.presheaf.map (homOfLE (X.basicOpen_le f)).op f) ^ n₂ *
            (S.sectionsUnitHom (X.basicOpen f) (X.presheaf.map (homOfLE (X.basicOpen_le f)).op f) ^ n₁ * x) +
          S.sectionsUnitHom (X.basicOpen f) (X.presheaf.map (homOfLE (X.basicOpen_le f)).op f) ^ n₁ *
            (S.sectionsUnitHom (X.basicOpen f) (X.presheaf.map (homOfLE (X.basicOpen_le f)).op f) ^ n₂ * y) =
        S.sectionsUnitHom (X.basicOpen f) (X.presheaf.map (homOfLE (X.basicOpen_le f)).op f) ^ (n₁ + n₂) *
          (x + y) := fun x y => by ring
    exact key x y

/-- **Lifting along localization**: an element of the ideal `(A(D f)_1)` on `D(f)`, multiplied by some power of
`f`, comes from an element of `(A(U)_1)`. Induction on `Ideal.span`: generators by
`exists_pow_mul_eq_restrict_ofPiece` (piece `1`), sums by adding the exponents, and scalars `c • z` by lifting
the coefficient `c` with `exists_pow_mul_eq_restrict_sectionsRing`. -/
theorem exists_pow_mul_eq_restrict_of_mem_sectionsDegOneIdeal {U : X.Opens}
    (hU : AlgebraicGeometry.IsAffineOpen U) (f : Γ(X, U)) {z : S.sectionsRing (X.basicOpen f)}
    (hz : z ∈ S.sectionsDegOneIdeal (X.basicOpen f)) :
    ∃ (n : ℕ) (w : S.sectionsRing U), w ∈ S.sectionsDegOneIdeal U ∧
      S.sectionsRestrictHom (X.basicOpen_le f) w =
        S.sectionsUnitHom (X.basicOpen f) (X.presheaf.map (homOfLE (X.basicOpen_le f)).op f) ^ n * z := by
  have hres : S.sectionsRestrictHom (X.basicOpen_le f) (S.sectionsUnitHom U f) =
      S.sectionsUnitHom (X.basicOpen f) (X.presheaf.map (homOfLE (X.basicOpen_le f)).op f) :=
    S.sectionsUnitHom_naturality (X.basicOpen_le f) f
  refine Submodule.span_induction
    (p := fun z _ => ∃ (n : ℕ) (w : S.sectionsRing U), w ∈ S.sectionsDegOneIdeal U ∧
      S.sectionsRestrictHom (X.basicOpen_le f) w =
        S.sectionsUnitHom (X.basicOpen f) (X.presheaf.map (homOfLE (X.basicOpen_le f)).op f) ^ n * z)
    ?_ ?_ ?_ ?_ hz
  · rintro x ⟨t, rfl⟩
    obtain ⟨n, t', ht'⟩ := S.exists_pow_mul_eq_restrict_ofPiece hU f 1 t
    exact ⟨n, S.ofPiece U 1 t', S.ofPiece_one_mem_sectionsDegOneIdeal U t', ht'⟩
  · exact ⟨0, 0, Ideal.zero_mem _, by rw [map_zero, mul_zero]⟩
  · rintro x y _ _ ⟨n₁, w₁, hw₁, e₁⟩ ⟨n₂, w₂, hw₂, e₂⟩
    refine ⟨n₁ + n₂, S.sectionsUnitHom U f ^ n₂ * w₁ + S.sectionsUnitHom U f ^ n₁ * w₂,
      Ideal.add_mem _ (Ideal.mul_mem_left _ _ hw₁) (Ideal.mul_mem_left _ _ hw₂), ?_⟩
    rw [map_add, map_mul, map_mul, map_pow, map_pow, hres, e₁, e₂]
    ring
  · rintro c x _ ⟨n, w, hw, e⟩
    obtain ⟨n', c', e'⟩ := S.exists_pow_mul_eq_restrict_sectionsRing hU f c
    refine ⟨n' + n, c' * w, Ideal.mul_mem_left _ _ hw, ?_⟩
    rw [smul_eq_mul, map_mul, e', e, pow_add]
    ring

end AlgebraicGeometry.Scheme.GradedQCAlgebra

/-- Sheaf-level "generated in degree one" implies that on an affine open `U` the section ring
`A(U) := ⊕_m Γ(U, 𝒜_m)` satisfies `A(U)_+ ⊆ (A(U)_1)` (i.e. `A(U)` is generated over `A(U)_0` by `A(U)_1`).

Reference: Stacks 01O4, first paragraph ("over affine opens of `S`").

**Proof** (the localization argument of `SufficientlyDivisible.toGradedAffineAlgebra`):
1. `HomogeneousIdeal.toIdeal_irrelevant_le`: it suffices to show, for `d = k+1 > 0` and `a = ofPiece s`
   (`s ∈ Γ(U, 𝒜_{k+1})`), that `a ∈ J(U) := (A(U)_1)`.
2. `h𝒜 (k+1)`: `μ := mulPowOne (k+1)` is an epimorphism, so by `epi_iff_locally_surjective_sections` near
   every point `p` we have `s|_V = μ(y)`.
3. `goodDegOne_succ`: every section `y` of the tensor power `(𝒜_1)^{⊗(k+1)}` satisfies `ofPiece (μ y) ∈ J`
   near every point — the sheafification unit is locally surjective (`GenAux.exists_tensor_unit_app_eq_map`,
   Mathlib `isLocallySurjective_toSheafify`), so `y` is locally a sum of pure tensors `a ⊗ b`
   (`b ∈ Γ(·, 𝒜_1)`); `mulPowOne_succ_app'` gives `μ(a ⊗ b) = (mulPowOne k a)·b`, which in the section ring is
   `ofPiece(mulPowOne k a) * ofPiece b ∈ J` (`inDegOne_succ_tmul`); sums by `GoodDegOne.add`.
   **No induction on `k` is needed** (the ideal absorbs any left factor).
4. Take a principal open `D(f) ∋ p` (`IsAffineOpen.exists_basicOpen_le`), giving `ofPiece (s|_{D f}) ∈ J(D f)`;
   `exists_pow_mul_eq_restrict_of_mem_sectionsDegOneIdeal` (`𝒜_1` and the pieces are quasi-coherent,
   `exists_pow_smul_eq_map_basicOpen`) lifts: `f^n s` agrees on `D(f)` with some `w ∈ J(U)`;
   `exists_pow_mul_eq_zero_of_restrict_eq_zero` (`A(D f) = A(U)[1/f]`, `affineUnit_coequifibered`) gives
   `f^N (w − f^n s) = 0`, hence `f^{N+n} a ∈ J(U)`.
5. `I := {r ∈ Γ(X,U) | unit(r) · a ∈ J(U)}` is an ideal containing some `f_p^{e_p}` (`e_p ≥ 1`) for every
   point, and the `D(f_p^{e_p})` cover `U`; `U` affine (`IsAffineOpen.self_le_iSup_basicOpen_iff`) ⇒ `I = ⊤`
   ⇒ `1 ∈ I` ⇒ `a ∈ J(U)`.

Edge cases: the degree-`0` part is not in `A(U)_+`, so nothing to show; for `U = ∅`, `A(U)` is the zero ring
and both sides are `⊤`; if `𝒜_1 = 0`, then `h𝒜` forces `𝒜_ℓ = 0` (`ℓ ≥ 1`) and `A(U)_+ = 0`. -/
theorem AlgebraicGeometry.Scheme.GradedQCAlgebra.irrelevant_le_span_degOne_of_generatedInDegreeOne
    {X : AlgebraicGeometry.Scheme.{u}} (𝒜 : X.GradedQCAlgebra) (h𝒜 : 𝒜.GeneratedInDegreeOne)
    (U : X.affineOpens) :
    (HomogeneousIdeal.irrelevant (𝒜.sectionsGrading U.1)).toIdeal ≤
      Ideal.span ((𝒜.sectionsGrading U.1 1 : AddSubgroup (𝒜.sectionsRing U.1)) :
        Set (𝒜.sectionsRing U.1)) := by
  rw [HomogeneousIdeal.toIdeal_irrelevant_le]
  intro d hd x hx
  obtain ⟨s, rfl⟩ : ∃ s : 𝒜.sectionsPiece U.1 d, DirectSum.of (𝒜.sectionsPiece U.1) d s = x := hx
  obtain ⟨k, rfl⟩ : ∃ k, d = k + 1 := ⟨d - 1, by omega⟩
  change 𝒜.ofPiece U.1 (k + 1) s ∈ 𝒜.sectionsDegOneIdeal U.1
  have hUaff : AlgebraicGeometry.IsAffineOpen U.1 := U.2
  have hepi := (AlgebraicGeometry.Scheme.Modules.epi_iff_locally_surjective_sections
    (𝒜.mulPowOne (k + 1))).mp (h𝒜 (k + 1) (Nat.succ_pos k))
  -- the ideal `I = {r | unit(r) · a ∈ J}`
  let I : Ideal Γ(X, U.1) :=
    { carrier := {r | 𝒜.sectionsUnitHom U.1 r * 𝒜.ofPiece U.1 (k + 1) s ∈ 𝒜.sectionsDegOneIdeal U.1}
      zero_mem' := by
        rw [Set.mem_ofPred_eq, map_zero, zero_mul]
        exact Ideal.zero_mem _
      add_mem' := by
        intro r₁ r₂ h₁ h₂
        rw [Set.mem_ofPred_eq] at h₁ h₂ ⊢
        rw [map_add, add_mul]
        exact Ideal.add_mem _ h₁ h₂
      smul_mem' := by
        intro c r h
        rw [Set.mem_ofPred_eq] at h ⊢
        rw [smul_eq_mul, map_mul, _root_.mul_assoc]
        exact Ideal.mul_mem_left _ _ h }
  have hpt : ∀ p ∈ U.1, ∃ g : Γ(X, U.1), g ∈ I ∧ p ∈ X.basicOpen g := by
    intro p hp
    obtain ⟨V, hVU, hpV, y, hy⟩ := hepi U.1 s p hp
    obtain ⟨W', hW'V, hpW', hIn⟩ := 𝒜.goodDegOne_succ k V y p hpV
    obtain ⟨f, hfW', hpf⟩ := hUaff.exists_basicOpen_le (V := W') ⟨p, hpW'⟩ hp
    have hV : X.basicOpen f ≤ U.1 := X.basicOpen_le f
    have hres : 𝒜.sectionsRestrictHom hV (𝒜.sectionsUnitHom U.1 f) =
        𝒜.sectionsUnitHom (X.basicOpen f) (X.presheaf.map (homOfLE hV).op f) :=
      𝒜.sectionsUnitHom_naturality hV f
    have hIn2 := hIn.restrict (W₀ := X.basicOpen f) hfW'
    unfold AlgebraicGeometry.Scheme.GradedQCAlgebra.InDegOne at hIn2
    rw [AlgebraicGeometry.Scheme.GradedQCAlgebra.GenAux.map_map_res] at hIn2
    have hs : (𝒜.mulPowOne (k + 1)).app (X.basicOpen f)
        ((AlgebraicGeometry.Scheme.Modules.tensorPow (𝒜.part 1) (k + 1)).presheaf.map
          (homOfLE (hfW'.trans hW'V)).op y) =
        (𝒜.part (k + 1)).presheaf.map (homOfLE hV).op s :=
      (AlgebraicGeometry.Scheme.GradedQCAlgebra.GenAux.app_map_res (𝒜.mulPowOne (k + 1))
        (hfW'.trans hW'V) y).trans
        ((congrArg (fun t => (𝒜.part (k + 1)).presheaf.map (homOfLE (hfW'.trans hW'V)).op t) hy).trans
          (AlgebraicGeometry.Scheme.GradedQCAlgebra.GenAux.map_map_res (M := 𝒜.part (k + 1))
            (hfW'.trans hW'V) hVU s))
    have hIn3 : 𝒜.ofPiece (X.basicOpen f) (k + 1) ((𝒜.part (k + 1)).presheaf.map (homOfLE hV).op s)
        ∈ 𝒜.sectionsDegOneIdeal (X.basicOpen f) :=
      Set.mem_of_eq_of_mem (congrArg (𝒜.ofPiece (X.basicOpen f) (k + 1)) hs).symm hIn2
    obtain ⟨n, w, hw, hwe⟩ := 𝒜.exists_pow_mul_eq_restrict_of_mem_sectionsDegOneIdeal hUaff f hIn3
    have e4 : 𝒜.sectionsRestrictHom hV (𝒜.sectionsUnitHom U.1 f ^ n * 𝒜.ofPiece U.1 (k + 1) s) =
        𝒜.sectionsUnitHom (X.basicOpen f) (X.presheaf.map (homOfLE hV).op f) ^ n *
          𝒜.ofPiece (X.basicOpen f) (k + 1) ((𝒜.part (k + 1)).presheaf.map (homOfLE hV).op s) := by
      rw [map_mul, map_pow, hres]
      exact congrArg (𝒜.sectionsUnitHom (X.basicOpen f) (X.presheaf.map (homOfLE hV).op f) ^ n * ·)
        (𝒜.sectionsRestrictHom_ofPiece hV (k + 1) s)
    have e5 : 𝒜.sectionsRestrictHom hV
        (w - 𝒜.sectionsUnitHom U.1 f ^ n * 𝒜.ofPiece U.1 (k + 1) s) = 0 := by
      rw [map_sub, hwe, e4, sub_self]
    obtain ⟨N, hN⟩ := 𝒜.exists_pow_mul_eq_zero_of_restrict_eq_zero ⟨U.1, U.2⟩ f _ e5
    have e6 : 𝒜.sectionsUnitHom U.1 f ^ N *
        (𝒜.sectionsUnitHom U.1 f ^ n * 𝒜.ofPiece U.1 (k + 1) s) =
        𝒜.sectionsUnitHom U.1 f ^ N * w := by
      rw [mul_sub, sub_eq_zero] at hN
      exact hN.symm
    have hmem : 𝒜.sectionsUnitHom U.1 (f ^ (N + n)) * 𝒜.ofPiece U.1 (k + 1) s ∈
        𝒜.sectionsDegOneIdeal U.1 := by
      rw [map_pow, pow_add, _root_.mul_assoc, e6]
      exact Ideal.mul_mem_left _ _ hw
    refine ⟨f ^ (N + n + 1), ?_, ?_⟩
    · have : f ^ (N + n) ∈ I := hmem
      rw [pow_succ]
      exact I.mul_mem_right f this
    · rw [X.basicOpen_pow f (Nat.succ_pos _)]
      exact hpf
  have hcov : U.1 ≤ ⨆ g : (I : Set Γ(X, U.1)), X.basicOpen g.1 := by
    intro p hp
    obtain ⟨g, hgI, hpg⟩ := hpt p hp
    exact TopologicalSpace.Opens.mem_iSup.mpr ⟨⟨g, hgI⟩, hpg⟩
  have hspan : Ideal.span (I : Set Γ(X, U.1)) = ⊤ := hUaff.self_le_iSup_basicOpen_iff.mp hcov
  rw [Ideal.span_eq] at hspan
  have h1 : (1 : Γ(X, U.1)) ∈ I := hspan ▸ Submodule.mem_top
  have h1' : 𝒜.sectionsUnitHom U.1 1 * 𝒜.ofPiece U.1 (k + 1) s ∈ 𝒜.sectionsDegOneIdeal U.1 := h1
  rw [map_one, _root_.one_mul] at h1'
  exact h1'

end
