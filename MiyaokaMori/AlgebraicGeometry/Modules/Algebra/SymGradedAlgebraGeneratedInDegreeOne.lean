import MiyaokaMori.Prelude
import MiyaokaMori.AlgebraicGeometry.Proj.RelativeProj.GeneratedInDegreeOne
import MiyaokaMori.AlgebraicGeometry.Modules.Algebra.SheafSymmetricAlgebra

/-! # The symmetric algebra sheaf is generated in degree one

For a quasi-coherent `O_X`-module `V` the symmetric algebra `Sym(V) = symGradedAlgebra V` is generated in
degree one: for every `ℓ ≥ 1` the iterated multiplication `mulPowOne ℓ : (Sym^1 V)^{⊗ℓ} → Sym^ℓ V` is an
epimorphism.

Proof:
1. V quasicoherent ⇒ `symGradedAlgebra V = symGradedAlgebraOfQC V _` (`dif_pos`), so part m = `symPow V m`,
   `mul m n = symPowMul V m n`, `one = symPowπ V 0`.
2. The quotient maps `symPowπ V m : V^{⊗m} → Sym^m V` are epimorphisms (`symPowπ_epi`), and `symPowMul` is the
   map induced on the quotients by the identification V^{⊗m} ⊗ V^{⊗n} ≅ V^{⊗(m+n)} (`monoidalPowCat`,
   `symPowDesc₂`): (symPowπ m ⊗ symPowπ n) ≫ symPowMul m n = (monoidalPowCat m n).hom ≫ symPowπ (m + n)
   (the defining equation of `symPowDesc₂`, `symPowπ_desc`). Since the right side is an epimorphism,
   `symPowMul m n` is an epimorphism for all m, n.
3. Induction on ℓ ≥ 1. ℓ = 1: `mulPowOne 1 = tensorIsoTensorObj.hom ≫ (one ▷ Sym^1) ≫ mul 0 1`, and by `one_mul`
   the last two factors compose to `(λ_ _).hom ≫ eqToHom _`, an isomorphism; so `mulPowOne 1` is an isomorphism,
   in particular epi. ℓ + 1: `mulPowOne (ℓ+1) = tensorIsoTensorObj.hom ≫ (mulPowOne ℓ ▷ Sym^1) ≫ mul ℓ 1`;
   whiskering preserves epimorphisms in `X.Modules` (tensoring is right exact: `⊗` has a right adjoint /
   `MonoidalCategory` whiskering of an epi is epi in a monoidal closed abelian category; concretely
   `symPowπ_whiskerRight_cancel`-type lemmas in `SheafSymmetricAlgebra.lean`), `mul ℓ 1` is epi by step 2, and
   compositions of epis are epi (`epi_comp`).
References: Stacks 01N0 (generated in degree one); Bourbaki Algebra III §6 (`Sym` is generated by `Sym^1`).
The formal proof follows this route, using `tensorHom_symPowπ_symPowMul` and `epi_whiskerRight_of_epi`
(`SheafSymmetricAlgebra.lean`); the case `ℓ = 0` is also an epimorphism (`Sym^0` is a quotient of `𝟙_`), so the
induction needs no base case `ℓ = 1`. Used to show that `P(V) → X` is a projective morphism.
-/

set_option autoImplicit false
set_option maxHeartbeats 400000

universe u

open CategoryTheory CategoryTheory.Limits Opposite TopologicalSpace
open scoped AlgebraicGeometry
open scoped CategoryTheory.MonoidalCategory

noncomputable section

theorem AlgebraicGeometry.Scheme.Modules.symGradedAlgebra_generatedInDegreeOne
    {X : AlgebraicGeometry.Scheme.{u}} (V : X.Modules) [hV : V.IsQuasicoherent] :
    (AlgebraicGeometry.Scheme.Modules.symGradedAlgebra V).GeneratedInDegreeOne := by
  have hE : AlgebraicGeometry.Scheme.Modules.symGradedAlgebra V =
      AlgebraicGeometry.Scheme.Modules.symGradedAlgebraOfQC V hV := by
    delta AlgebraicGeometry.Scheme.Modules.symGradedAlgebra
    exact dif_pos hV
  rw [hE]
  -- multiplication Sym^m ⊗ Sym^n → Sym^{m+n} is an epimorphism
  have hmul : ∀ m n : ℕ, Epi (AlgebraicGeometry.Scheme.Modules.symPowMul V m n) := fun m n => by
    have h1 : Epi ((AlgebraicGeometry.Scheme.Modules.symPowπ V m ⊗ₘ
        AlgebraicGeometry.Scheme.Modules.symPowπ V n) ≫
          AlgebraicGeometry.Scheme.Modules.symPowMul V m n) := by
      rw [AlgebraicGeometry.Scheme.Modules.tensorHom_symPowπ_symPowMul]
      exact @epi_comp _ _ _ _ _ (AlgebraicGeometry.Scheme.Modules.monoidalPowCat V m n).hom
        (@IsIso.epi_of_iso _ _ _ _ _ (Iso.isIso_hom _))
        (AlgebraicGeometry.Scheme.Modules.symPowπ V (m + n))
        (AlgebraicGeometry.Scheme.Modules.symPowπ_epi V (m + n))
    exact @epi_of_epi _ _ _ _ _ _ _ h1
  have key : ∀ ℓ : ℕ,
      Epi ((AlgebraicGeometry.Scheme.Modules.symGradedAlgebraOfQC V hV).mulPowOne ℓ) := by
    intro ℓ
    induction ℓ with
    | zero => exact AlgebraicGeometry.Scheme.Modules.symPowπ_epi V 0
    | succ ℓ ih =>
      have h2 : Epi ((AlgebraicGeometry.Scheme.Modules.symGradedAlgebraOfQC V hV).mulPowOne ℓ ▷
          (AlgebraicGeometry.Scheme.Modules.symGradedAlgebraOfQC V hV).part 1) :=
        @AlgebraicGeometry.Scheme.Modules.epi_whiskerRight_of_epi _ _ _ _ ih _
      have h3 : Epi ((AlgebraicGeometry.Scheme.Modules.symGradedAlgebraOfQC V hV).mul ℓ 1) := hmul ℓ 1
      exact @epi_comp _ _ _ _ _ _ (@IsIso.epi_of_iso _ _ _ _ _ (Iso.isIso_hom _)) _
        (@epi_comp _ _ _ _ _ _ h2 _ h3)
  exact fun ℓ _ => key ℓ

end
