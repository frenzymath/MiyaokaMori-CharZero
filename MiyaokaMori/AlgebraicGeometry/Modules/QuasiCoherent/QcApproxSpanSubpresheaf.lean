import MiyaokaMori.Prelude
import MiyaokaMori.AlgebraicGeometry.Modules.QuasiCoherent.QcSectionsBasicOpenLocalization
import MiyaokaMori.AlgebraicGeometry.Modules.QuasiCoherent.QcApproxGoodOn
import MiyaokaMori.AlgebraicGeometry.Modules.QuasiCoherent.QcApproxSpanAffine

/-! # The sub-presheaf generated by finitely many sections over an affine open

Support module for `QcFiniteTypeApproxFiniteSections` (Stacks 01PE / 01PC).

Let `F` be a quasi-coherent module on a scheme `S`, `W` an affine open and `e : ι → Γ(F, W)` finitely many
sections. `spanSub F W e` is the sub-presheaf of `F` whose sections over `U'` are the `t ∈ F(U')` that are,
locally on `U' ⊓ W`, `O`-linear combinations of the `e i`. It is

* on affine opens `U'' ≤ W`, exactly the `Γ(S, U'')`-span of the `e i|_{U''}` (`mem_spanSub_iff_mem_span`,
  by `mem_span_of_locally`);
* **good on `W`** (`goodOn_spanSub`): locality holds by construction; the localization property and
  saturation on affine `U'' ≤ W` come from `exists_pow_smul_mem_span_of_map_mem_span` and from writing
  coefficients over `D(h)` as `b / h ^ n`; finite type: `spanSub(W)` is the span of the `e i`.

This is Stacks 01PE for one affine (`E := O_V · s`) and provides the extension `G'` of Stacks 01PC once the
right generators `e` have been chosen (`QcFiniteTypeApproxFiniteSections_Extend`).
-/

set_option autoImplicit false
set_option maxHeartbeats 400000

universe u v

open CategoryTheory CategoryTheory.Limits Opposite TopologicalSpace
open scoped AlgebraicGeometry

noncomputable section

namespace AlgebraicGeometry.Scheme.Modules.QcApprox

variable {S : AlgebraicGeometry.Scheme.{u}} (F : S.Modules)

/-- The `Γ(S, U₀)`-span of the restrictions of the `e i` to `U₀ ≤ W`. -/
abbrev spanRes {W : S.Opens} {ι : Type v} (e : ι → Γ(F, W)) {U₀ : S.Opens} (h₀ : U₀ ≤ W) :
    Submodule Γ(S, U₀) Γ(F, U₀) :=
  Submodule.span Γ(S, U₀) (Set.range fun i => F.presheaf.map (homOfLE h₀).op (e i))

/-- The predicate "`t` is locally on `U' ⊓ W` a combination of the `e i`". -/
def LocallySpan {W : S.Opens} {ι : Type v} (e : ι → Γ(F, W)) (U' : S.Opens) (t : Γ(F, U')) : Prop :=
  ∀ x ∈ U' ⊓ W, ∃ (U₀ : S.Opens) (h₀ : U₀ ≤ U' ⊓ W), x ∈ U₀ ∧
    F.presheaf.map (homOfLE (h₀.trans inf_le_left)).op t ∈ spanRes F e (h₀.trans inf_le_right)

variable {F}

theorem LocallySpan.map {W : S.Opens} {ι : Type v} {e : ι → Γ(F, W)} {U' V' : S.Opens} (h : V' ≤ U')
    {t : Γ(F, U')} (ht : LocallySpan F e U' t) :
    LocallySpan F e V' (F.presheaf.map (homOfLE h).op t) := by
  intro x hx
  obtain ⟨U₀, h₀, hx₀, ht₀⟩ := ht x ⟨h hx.1, hx.2⟩
  refine ⟨U₀ ⊓ V', le_inf inf_le_right (inf_le_left.trans (h₀.trans inf_le_right)), ⟨hx₀, hx.1⟩, ?_⟩
  rw [map_map]
  have := map_mem_span_range_map F (inf_le_left : U₀ ⊓ V' ≤ U₀) _ ht₀
  simp only [map_map] at this
  exact this

theorem LocallySpan.zero {W : S.Opens} {ι : Type v} (e : ι → Γ(F, W)) (U' : S.Opens) :
    LocallySpan F e U' 0 := fun x hx =>
  ⟨U' ⊓ W, le_rfl, hx, by rw [map_zero]; exact Submodule.zero_mem _⟩

theorem LocallySpan.add {W : S.Opens} {ι : Type v} {e : ι → Γ(F, W)} {U' : S.Opens} {s t : Γ(F, U')}
    (hs : LocallySpan F e U' s) (ht : LocallySpan F e U' t) : LocallySpan F e U' (s + t) := by
  intro x hx
  obtain ⟨U₁, h₁, hx₁, hs₁⟩ := hs x hx
  obtain ⟨U₂, h₂, hx₂, ht₂⟩ := ht x hx
  refine ⟨U₁ ⊓ U₂, inf_le_left.trans h₁, ⟨hx₁, hx₂⟩, ?_⟩
  rw [map_add]
  refine Submodule.add_mem _ ?_ ?_
  · have := map_mem_span_range_map F (inf_le_left : U₁ ⊓ U₂ ≤ U₁) _ hs₁
    simp only [map_map] at this
    exact this
  · have := map_mem_span_range_map F (inf_le_right : U₁ ⊓ U₂ ≤ U₂) _ ht₂
    simp only [map_map] at this
    exact this

theorem LocallySpan.smul {W : S.Opens} {ι : Type v} {e : ι → Γ(F, W)} {U' : S.Opens} (r : Γ(S, U'))
    {t : Γ(F, U')} (ht : LocallySpan F e U' t) : LocallySpan F e U' (r • t) := by
  intro x hx
  obtain ⟨U₀, h₀, hx₀, ht₀⟩ := ht x hx
  refine ⟨U₀, h₀, hx₀, ?_⟩
  rw [AlgebraicGeometry.Scheme.Modules.map_smul]
  exact Submodule.smul_mem _ _ ht₀

variable (F)

/-- The sub-presheaf of `F` generated (as a subsheaf) by the sections `e i ∈ Γ(F, W)`: sections that are
locally on `U' ⊓ W` combinations of the `e i`. Outside `W` there is no condition. -/
def spanSub (W : S.Opens) {ι : Type v} (e : ι → Γ(F, W)) : F.val.Submodule where
  obj U' :=
    { carrier := { t | LocallySpan F e U'.unop t }
      zero_mem' := LocallySpan.zero e U'.unop
      add_mem' := fun hs ht => LocallySpan.add hs ht
      smul_mem' := fun r _ ht => LocallySpan.smul r ht }
  map {U' V'} f := by
    intro t ht
    obtain ⟨t', rfl⟩ : ∃ t' : Γ(F, U'.unop), t' = t := ⟨t, rfl⟩
    exact LocallySpan.map (leOfHom f.unop) ht

theorem mem_spanSub_iff (W : S.Opens) {ι : Type v} (e : ι → Γ(F, W)) (U' : S.Opens) (t : Γ(F, U')) :
    t ∈ objΓ (spanSub F W e) U' ↔ LocallySpan F e U' t :=
  Iff.rfl

variable [F.IsQuasicoherent]

/-- On an affine open `U'' ≤ W`, `spanSub F W e` is exactly the span of the restricted `e i`
(`mem_span_of_locally`). -/
theorem mem_spanSub_iff_mem_span {W : S.Opens} {ι : Type v} [Fintype ι] (e : ι → Γ(F, W))
    {U'' : S.Opens} (hU'' : AlgebraicGeometry.IsAffineOpen U'') (hle : U'' ≤ W) (t : Γ(F, U'')) :
    t ∈ objΓ (spanSub F W e) U'' ↔ t ∈ spanRes F e hle := by
  rw [mem_spanSub_iff]
  constructor
  · intro ht
    apply mem_span_of_locally F hU'' (fun i => F.presheaf.map (homOfLE hle).op (e i)) t
    intro x hx
    obtain ⟨U₀, h₀, hx₀, ht₀⟩ := ht x ⟨hx, hle hx⟩
    refine ⟨U₀, h₀.trans inf_le_left, hx₀, ?_⟩
    simp only [map_map]
    exact ht₀
  · intro ht x hx
    refine ⟨U'', le_inf le_rfl hle, hx.1, ?_⟩
    rw [map_self]
    exact ht

/-- `spanSub F W e` equals the span of the restricted `e i` on affine opens `U'' ≤ W`. -/
theorem spanSub_obj_eq_span {W : S.Opens} {ι : Type v} [Fintype ι] (e : ι → Γ(F, W))
    {U'' : S.Opens} (hU'' : AlgebraicGeometry.IsAffineOpen U'') (hle : U'' ≤ W) :
    objΓ (spanSub F W e) U'' = spanRes F e hle := by
  ext t
  exact mem_spanSub_iff_mem_span F e hU'' hle t

/-- **`spanSub` is good on `W`** (`W` affine, `F` quasi-coherent, `ι` finite). -/
theorem goodOn_spanSub {W : S.Opens} (hW : AlgebraicGeometry.IsAffineOpen W) {ι : Type v} [Fintype ι]
    (e : ι → Γ(F, W)) : GoodOn F (spanSub F W e) W where
  mem_of_locally U' _ t ht := by
    rw [mem_spanSub_iff]
    intro x hx
    obtain ⟨U₀, h₀, hx₀, ht₀⟩ := ht x hx.1
    rw [mem_spanSub_iff] at ht₀
    obtain ⟨U₁, h₁, hx₁, ht₁⟩ := ht₀ x ⟨hx₀, hx.2⟩
    refine ⟨U₁, h₁.trans (inf_le_inf_right W h₀), hx₁, ?_⟩
    rw [map_map] at ht₁
    exact ht₁
  exists_pow_smul_eq_map U'' hle haff h s hs := by
    classical
    rw [mem_spanSub_iff_mem_span F e (haff.basicOpen h) ((S.basicOpen_le h).trans hle)] at hs
    obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun _).mp hs
    have hloc : IsLocalization.Away h Γ(S, S.basicOpen h) := haff.isLocalization_basicOpen h
    have hcoef : ∀ i, ∃ (b : Γ(S, U'')) (n : ℕ),
        c i * (S.presheaf.map (homOfLE (S.basicOpen_le h)).op h) ^ n =
          S.presheaf.map (homOfLE (S.basicOpen_le h)).op b := by
      intro i
      obtain ⟨⟨b, ⟨_, n, rfl⟩⟩, hb⟩ := IsLocalization.surj (Submonoid.powers h) (c i)
      refine ⟨b, n, ?_⟩
      have e1 : algebraMap Γ(S, U'') Γ(S, S.basicOpen h) =
          (S.presheaf.map (homOfLE (S.basicOpen_le h)).op).hom := rfl
      rw [e1, map_pow] at hb
      exact hb
    choose b n hbn using hcoef
    set N := Finset.univ.sup n with hN
    refine ⟨N, ∑ i, (h ^ (N - n i) * b i) • F.presheaf.map (homOfLE hle).op (e i), ?_, ?_⟩
    · rw [mem_spanSub_iff_mem_span F e haff hle]
      exact Submodule.sum_mem _ fun i _ => Submodule.smul_mem _ _ (Submodule.subset_span ⟨i, rfl⟩)
    · rw [← hc, Finset.smul_sum, map_sum]
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [AlgebraicGeometry.Scheme.Modules.map_smul, map_mul, map_pow, map_map, smul_smul, ← hbn i]
      congr 1
      have hle' : n i ≤ N := Finset.le_sup (f := n) (Finset.mem_univ i)
      conv_rhs => rw [← Nat.sub_add_cancel hle', pow_add]
      ring
  exists_pow_smul_mem U'' hle haff h t ht := by
    rw [mem_spanSub_iff_mem_span F e (haff.basicOpen h) ((S.basicOpen_le h).trans hle)] at ht
    obtain ⟨N, hN⟩ := exists_pow_smul_mem_span_of_map_mem_span F haff h
      (fun i => F.presheaf.map (homOfLE hle).op (e i)) t (by simpa only [map_map] using ht)
    refine ⟨N, ?_⟩
    rw [mem_spanSub_iff_mem_span F e haff hle]
    exact hN
  exists_affine_fg x hx := by
    classical
    refine ⟨W, hW, hx, le_rfl, Fintype.card ι, fun j => e ((Fintype.equivFin ι).symm j), ?_⟩
    rw [spanSub_obj_eq_span F e hW le_rfl]
    have hrange : (Set.range fun i => F.presheaf.map (homOfLE (le_rfl : W ≤ W)).op (e i)) =
        Set.range fun j => e ((Fintype.equivFin ι).symm j) := by
      ext t
      simp only [Set.mem_range, map_self]
      constructor
      · rintro ⟨i, rfl⟩
        exact ⟨Fintype.equivFin ι i, by simp⟩
      · rintro ⟨j, rfl⟩
        exact ⟨_, rfl⟩
    show Submodule.span Γ(S, W) _ = _
    rw [hrange]

end AlgebraicGeometry.Scheme.Modules.QcApprox

end
