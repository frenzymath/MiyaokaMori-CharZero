import MiyaokaMori.Prelude

/-! # Finite type from finitely generated sections on affine opens

Let `X` be a scheme and `M` a quasi-coherent `O_X`-module. If every point `x ∈ X` has an affine open
neighbourhood `U` such that `Γ(U, M)` is a finitely generated `Γ(U, O_X)`-module, then `M` is of finite
type (`SheafOfModules.IsFiniteType`: there is an open cover of `X` on each member of which `M` is
generated by finitely many sections).

Proof:
1. (`~` on `Spec`) Let `R` be a ring and `P` a finitely generated `R`-module with finite generating set
   `s`. `R^s → P` is surjective, `~` preserves cokernels (a left adjoint, Mathlib `tilde.adjunction`),
   and `(R^s)^~ ≅ O^{⊕s}` (`tildeFinsupp`), so `O^{⊕s} → P^~` is an epimorphism: `P^~` has
   `GeneratingSections` indexed by the finite set `s` (the generators of Mathlib's `presentationTilde`).
2. (Quasi-coherent sheaves on `Spec`) Let `N` be quasi-coherent on `Spec R` with `Γ(Spec R, N)` a finite
   `R`-module: Mathlib's `Scheme.Modules.isIso_fromTildeΓ_of_isQuasicoherent` gives `Γ(N)^~ ≅ N`, and
   the finitely many generating sections of step 1 are transported along it (`GeneratingSections.ofEpi`).
3. (Back to the affine open `U` of `X`) Let `A = Γ(U, O_X)`, `j = hU.fromSpec : Spec A → X` (an open
   immersion with image `U`), `N = j^*M = M.restrict j`, quasi-coherent (`isQuasicoherent_restrictFunctor`).
   `Γ(Spec A, N) = Γ(j(⊤), M) = Γ(U, M)`, whose `A`-module structure corresponds to that of `Γ(U, M)`
   through the ring isomorphism `A ≅ Γ(j(⊤), O_X) ≅ Γ(Spec A, O) ≅ A` (a semilinear bijection), so it is
   still finitely generated; by step 2, `N` has finite `GeneratingSections`.
4. (Transport to `M.over U`) The functor `F = (restriction along U ≅ Spec A) ⋙ (U-modules ≃ modules over
   X.ringCatSheaf.over U, the inverse of Mathlib's Scheme.Modules.overEquiv)` is a composite of
   equivalences, preserves colimits and sends the structure sheaf to the structure sheaf
   (`restrictUnitIso`, `sheafOfModulesEquivOverInverseUnit`); `F(N) ≅ M.over U` (`restrictFunctorComp`,
   `isoSpec_hom_fromSpec`, `overFunctorEquiv`, the unit of the equivalence). `GeneratingSections.map` and
   `ofEpi` give finite `GeneratingSections` of `M.over U`.
5. For every point `x` take the `U_x` of the hypothesis; `(U_x)_{x∈X}` covers `X` (`x ∈ U_x`,
   `Opens.coversTop_iff`); together with the generating sections of step 4 this is a finite type
   `LocalGeneratorsData`, i.e. `M.IsFiniteType`.

Source: the "⇐" direction of Stacks 01PB (a quasi-coherent sheaf on an affine scheme is of finite type
iff its global sections are finitely generated) together with the locality of finite type (Stacks 01B5)
for open covers.
-/

set_option autoImplicit false
set_option maxHeartbeats 400000

universe u v w u' v'

open CategoryTheory CategoryTheory.Limits Opposite TopologicalSpace
open scoped AlgebraicGeometry

noncomputable section

open AlgebraicGeometry

private theorem finiteAffine.tilde_gen {R : CommRingCat.{u}} (P : ModuleCat.{u} R) [Module.Finite R P] :
    ∃ σ : (tilde P).GeneratingSections, σ.IsFiniteType := by
  obtain ⟨s, hs⟩ := (Module.Finite.fg_top : (⊤ : Submodule R P).FG)
  refine ⟨(presentationTilde P (s : Set P) hs _ (Submodule.span_eq _)).generators, ⟨?_⟩⟩
  exact inferInstanceAs (Finite (s : Set P))

private theorem finiteAffine.spec_gen {R : CommRingCat.{u}} (N : (Spec R).Modules) [N.IsQuasicoherent]
    [h : Module.Finite R Γ(N, ⊤)] :
    ∃ σ : N.GeneratingSections, σ.IsFiniteType := by
  have : Module.Finite R ((modulesSpecToSheaf.obj N).presheaf.obj (.op ⊤)) := h
  obtain ⟨σ, hσ⟩ := finiteAffine.tilde_gen ((modulesSpecToSheaf.obj N).presheaf.obj (.op ⊤))
  have : IsIso N.fromTildeΓ := Scheme.Modules.isIso_fromTildeΓ_of_isQuasicoherent N
  have : Epi (C := SheafOfModules _) N.fromTildeΓ := IsIso.epi_of_iso (C := (Spec R).Modules) _
  exact ⟨σ.ofEpi N.fromTildeΓ, ⟨hσ.finite⟩⟩
private theorem finiteAffine.finite_restrict {X : Scheme.{u}} (M : X.Modules) {U : X.Opens} (hU : IsAffineOpen U)
    [Module.Finite Γ(X, U) Γ(M, U)] :
    Module.Finite Γ(X, U) Γ(M.restrict hU.fromSpec, ⊤) := by
  have hV : hU.fromSpec ''ᵁ ⊤ = U := by
    rw [Scheme.Hom.image_top_eq_opensRange, hU.opensRange_fromSpec]
  let e : Γ(X, U) ≃+* Γ(X, U) :=
    ((X.presheaf.mapIso (eqToIso hV).op) ≪≫ (hU.fromSpec.appIso ⊤) ≪≫
      Scheme.ΓSpecIso Γ(X, U)).commRingCatIsoToRingEquiv
  let _ : RingHomSurjective (e : Γ(X, U) →+* Γ(X, U)) := ⟨e.surjective⟩
  have key : ∀ (r : Γ(X, hU.fromSpec ''ᵁ ⊤)) (y : Γ(M, hU.fromSpec ''ᵁ ⊤)),
      (M.restrictAppIso hU.fromSpec ⊤).inv (r • y) =
        ((hU.fromSpec.appIso ⊤).hom r) • (M.restrictAppIso hU.fromSpec ⊤).inv y := fun r y => by
    have := Scheme.Modules.smul_restrictAppIso_inv_apply hU.fromSpec M ⊤ r y
    exact this
  let g : Γ(M, U) →ₛₗ[(e : Γ(X, U) →+* Γ(X, U))] Γ(M.restrict hU.fromSpec, ⊤) :=
    { toFun := fun m => (M.restrictAppIso hU.fromSpec ⊤).inv (M.presheaf.map (eqToHom hV).op m)
      map_add' := fun a b => by simp
      map_smul' := fun a m => by
        rw [Scheme.Modules.map_smul, key, Scheme.Modules.smul_Spec_def]
        congr 1
        simp only [e]
        have h1 : (Opens.leTop (⊤ : (Spec Γ(X, U)).Opens)).op = 𝟙 _ := Subsingleton.elim _ _
        rw [h1, CategoryTheory.Functor.map_id]
        simp [Iso.commRingCatIsoToRingEquiv] }
  refine Module.Finite.of_surjective g ?_
  exact ((ConcreteCategory.bijective_of_isIso (M.restrictAppIso hU.fromSpec ⊤).inv).surjective).comp
    (ConcreteCategory.bijective_of_isIso (M.presheaf.map (eqToHom hV).op)).surjective

private def finiteAffine.overF {X : Scheme.{u}} {U : X.Opens} (hU : IsAffineOpen U) :
    SheafOfModules.{u} (Spec Γ(X, U)).ringCatSheaf ⥤ SheafOfModules.{u} (X.ringCatSheaf.over U) :=
  Scheme.Modules.restrictFunctor hU.isoSpec.hom ⋙ (Scheme.Modules.overEquiv U).inverse

private instance finiteAffine.overF_pres {X : Scheme.{u}} {U : X.Opens} (hU : IsAffineOpen U) :
    PreservesColimitsOfSize.{u, u} (finiteAffine.overF hU) := by
  have h1 : PreservesColimitsOfSize.{u, u} (Scheme.Modules.restrictFunctor hU.isoSpec.hom) :=
    inferInstance
  have h2 : PreservesColimitsOfSize.{u, u} (Scheme.Modules.overEquiv U).inverse := inferInstance
  exact @comp_preservesColimits _ _ _ _ _ _ _ _ h1 h2

private theorem finiteAffine.over_gen {X : Scheme.{u}} (M : X.Modules) [M.IsQuasicoherent] {U : X.Opens}
    (hU : IsAffineOpen U) [Module.Finite Γ(X, U) Γ(M, U)] :
    ∃ σ : (M.over U).GeneratingSections, σ.IsFiniteType := by
  have := finiteAffine.finite_restrict M hU
  obtain ⟨σ, hσ⟩ := finiteAffine.spec_gen (M.restrict hU.fromSpec)
  let η : SheafOfModules.unit (X.ringCatSheaf.over U) ≅
      (finiteAffine.overF hU).obj (SheafOfModules.unit (Spec Γ(X, U)).ringCatSheaf) :=
    (U.sheafOfModulesEquivOverInverseUnit X.ringCatSheaf).symm ≪≫
      (Scheme.Modules.overEquiv U).inverse.mapIso
        (Scheme.Modules.restrictUnitIso hU.isoSpec.hom).symm
  let i : (finiteAffine.overF hU).obj (M.restrict hU.fromSpec) ≅ M.over U :=
    (Scheme.Modules.overEquiv U).inverse.mapIso
      ((Scheme.Modules.restrictFunctorComp hU.isoSpec.hom hU.fromSpec).symm.app M ≪≫
        (Scheme.Modules.restrictFunctorCongr hU.isoSpec_hom_fromSpec).app M ≪≫
        (Scheme.Modules.overFunctorEquiv U).symm.app M) ≪≫
      ((Scheme.Modules.overEquiv U).unitIso.app (M.over U)).symm
  have : Finite (σ.map (finiteAffine.overF hU) η).I := hσ.finite
  exact ⟨(σ.map (finiteAffine.overF hU) η).ofEpi i.hom, ⟨this⟩⟩

theorem AlgebraicGeometry.Scheme.Modules.isFiniteType_of_finite_affine_sections
    {X : AlgebraicGeometry.Scheme.{u}} (M : X.Modules) [M.IsQuasicoherent]
    (h : ∀ x : X, ∃ (U : X.Opens) (_ : AlgebraicGeometry.IsAffineOpen U) (_ : x ∈ U),
      Module.Finite Γ(X, U) Γ(M, U)) :
    M.IsFiniteType := by
  choose U hU hx hfin using h
  have hgen := fun x => finiteAffine.over_gen M (hU x)
  choose σ hσ using hgen
  have hc : (Opens.grothendieckTopology X).CoversTop U := by
    rw [Opens.coversTop_iff]
    exact eq_top_iff.mpr fun x _ => Opens.mem_iSup.mpr ⟨x, hx x⟩
  let d : SheafOfModules.LocalGeneratorsData.{u} M :=
    { I := X, X := U, coversTop := hc, generators := σ }
  have hd : d.IsFiniteType := { isFiniteType := hσ }
  exact { exists_localGeneratorsData := ⟨d, hd⟩ }

end
