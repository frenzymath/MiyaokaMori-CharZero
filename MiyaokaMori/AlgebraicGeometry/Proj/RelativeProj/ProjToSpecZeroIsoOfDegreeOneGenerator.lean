import MiyaokaMori.Prelude
import Mathlib.AlgebraicGeometry.ProjectiveSpectrum.Basic

/-! # Proj of a graded ring generated by one degree-one element is its degree-zero spectrum

**Statement.** Let `𝒜` be an `ℕ`-graded commutative ring and `t ∈ 𝒜 1` such that multiplication by
`t` is a bijection `𝒜 n → 𝒜 (n+1)` for every `n` (injective: `x ∈ 𝒜 n`, `x * t = 0 ⇒ x = 0`;
surjective: every `y ∈ 𝒜 (n+1)` is `x * t` with `x ∈ 𝒜 n`). Then the structure morphism
`Proj.toSpecZero 𝒜 : Proj 𝒜 ⟶ Spec 𝒜₀` is an isomorphism.

This is the argument of Stacks 01MI (Constructions, Example: `Proj A[T] = Spec A`), stated for an
abstract graded ring `𝒜 ≅ 𝒜₀[t]` instead of the polynomial ring, so that it applies directly to the
section rings of the Rees algebra on an affine open where the ideal is the unit ideal
(`BlowupIsoAwayFromCenterAffineLeaf.lean`, Stacks 02OS(1)); it also yields
Stacks 01MI itself with `𝒜 = MvPolynomial.homogeneousSubmodule (Fin 1) A`, `t = X 0`.

**Proof.**
1. The irrelevant ideal is contained in every homogeneous ideal `P` containing `t`
   (`irrelevant_le_of_degreeOne_generator`): a homogeneous element of degree `n + 1` is `x * t ∈ P`.
   Hence no relevant homogeneous prime contains `t`, i.e. `D₊(t) = Proj 𝒜`
   (`basicOpen_eq_top_of_degreeOne_generator`), so the open immersion
   `Proj.awayι 𝒜 t : Spec (𝒜_t)₀ ⟶ Proj 𝒜` is surjective, hence an isomorphism
   (`isIso_of_isOpenImmersion_of_opensRange_eq_top`).
2. `fromZeroRingHom : 𝒜₀ → (𝒜_t)₀`, `a ↦ a/1`, is bijective
   (`fromZeroRingHom_bijective_of_degreeOne_generator`): injective because `a * t^k = 0` forces
   `a = 0` (iterate the injectivity hypothesis); surjective because every element of `(𝒜_t)₀` is
   `a / t^n` with `a ∈ 𝒜 n` (`HomogeneousLocalization.Away.mk_surjective`), and `a = a₀ * t^n` with
   `a₀ ∈ 𝒜 0` (iterate the surjectivity hypothesis), so `a / t^n = a₀ / 1`.
3. `Proj.awayι_toSpecZero`: `awayι ≫ toSpecZero = Spec.map fromZeroRingHom`. Both `awayι` and the
   right-hand side are isomorphisms, hence so is `toSpecZero`
   (`IsIso.of_isIso_comp_left`).

Source: Stacks 01MI; the step "X' = X when the centre is empty" in the proof of 02OS(1), used for the
resolution in Corollary 4.3 of the paper. Edge cases: `A` the zero ring — `Proj` and `Spec` are both empty and every statement is
trivially true; the surjectivity proof handles `t^k = 0` through `Away.mk_surjective`, which already
covers the subsingleton case.
-/

set_option autoImplicit false

universe u

open CategoryTheory HomogeneousLocalization

noncomputable section

namespace AlgebraicGeometry.Proj

variable {σ : Type*} {A : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A]
  (𝒜 : ℕ → σ) [GradedRing 𝒜] {t : A}

/-- If every homogeneous element of positive degree is a multiple of `t`, then the irrelevant ideal is
contained in every homogeneous ideal containing `t`. -/
theorem irrelevant_le_of_degreeOne_generator
    (hsurj : ∀ (n : ℕ) (y : A), y ∈ 𝒜 (n + 1) → ∃ x ∈ 𝒜 n, x * t = y)
    (P : HomogeneousIdeal 𝒜) (hP : t ∈ P) : HomogeneousIdeal.irrelevant 𝒜 ≤ P := by
  rw [HomogeneousIdeal.irrelevant_le]
  intro i hi y hy
  obtain ⟨n, rfl⟩ : ∃ n, i = n + 1 := ⟨i - 1, by omega⟩
  have hy' : y ∈ 𝒜 (n + 1) := hy
  obtain ⟨x, -, rfl⟩ := hsurj n y hy'
  exact P.toIdeal.mul_mem_left x hP

/-- `D₊(t) = Proj 𝒜` when every homogeneous element of positive degree is a multiple of `t`. -/
theorem basicOpen_eq_top_of_degreeOne_generator
    (hsurj : ∀ (n : ℕ) (y : A), y ∈ 𝒜 (n + 1) → ∃ x ∈ 𝒜 n, x * t = y) :
    Proj.basicOpen 𝒜 t = ⊤ := by
  refine top_le_iff.mp fun x _ => ?_
  rw [Proj.mem_basicOpen]
  intro hmem
  exact x.not_irrelevant_le
    (irrelevant_le_of_degreeOne_generator 𝒜 hsurj x.asHomogeneousIdeal hmem)

/-- The chart `Spec (𝒜_t)₀ ⟶ Proj 𝒜` is an isomorphism when `D₊(t) = Proj 𝒜`. -/
theorem isIso_awayι_of_degreeOne_generator (ht : t ∈ 𝒜 1)
    (hsurj : ∀ (n : ℕ) (y : A), y ∈ 𝒜 (n + 1) → ∃ x ∈ 𝒜 n, x * t = y) :
    IsIso (Proj.awayι 𝒜 t ht one_pos) :=
  isIso_of_isOpenImmersion_of_opensRange_eq_top _
    ((Proj.opensRange_awayι 𝒜 t ht one_pos).trans
      (basicOpen_eq_top_of_degreeOne_generator 𝒜 hsurj))

omit [AddSubgroupClass σ A] [GradedRing 𝒜] in
/-- Iterating the surjectivity hypothesis: every `y ∈ 𝒜 n` is `x * t ^ n` with `x ∈ 𝒜 0`. -/
theorem exists_mul_pow_eq_of_mem_of_degreeOne_generator
    (hsurj : ∀ (n : ℕ) (y : A), y ∈ 𝒜 (n + 1) → ∃ x ∈ 𝒜 n, x * t = y)
    (n : ℕ) : ∀ (y : A), y ∈ 𝒜 n → ∃ x ∈ 𝒜 0, x * t ^ n = y := by
  induction n with
  | zero => intro y hy; exact ⟨y, hy, by simp⟩
  | succ n ih =>
    intro y hy
    obtain ⟨x, hx, rfl⟩ := hsurj n y hy
    obtain ⟨x0, hx0, rfl⟩ := ih x hx
    exact ⟨x0, hx0, by ring⟩

/-- Iterating the injectivity hypothesis: `x ∈ 𝒜 0`, `x * t ^ k = 0 ⇒ x = 0`. -/
theorem eq_zero_of_mul_pow_eq_zero_of_degreeOne_generator (ht : t ∈ 𝒜 1)
    (hinj : ∀ (n : ℕ) (x : A), x ∈ 𝒜 n → x * t = 0 → x = 0)
    (k : ℕ) : ∀ (x : A), x ∈ 𝒜 0 → x * t ^ k = 0 → x = 0 := by
  induction k with
  | zero => intro x _ hx; simpa using hx
  | succ k ih =>
    intro x hx0 hx
    refine ih x hx0 ?_
    refine hinj k (x * t ^ k) ?_ ?_
    · simpa using SetLike.mul_mem_graded hx0 (SetLike.pow_mem_graded k ht)
    · rw [← hx]; ring

/-- `𝒜₀ → (𝒜_t)₀`, `a ↦ a / 1`, is bijective when multiplication by `t` is a bijection
`𝒜 n → 𝒜 (n+1)` for every `n`. -/
theorem fromZeroRingHom_bijective_of_degreeOne_generator (ht : t ∈ 𝒜 1)
    (hinj : ∀ (n : ℕ) (x : A), x ∈ 𝒜 n → x * t = 0 → x = 0)
    (hsurj : ∀ (n : ℕ) (y : A), y ∈ 𝒜 (n + 1) → ∃ x ∈ 𝒜 n, x * t = y) :
    Function.Bijective (fromZeroRingHom 𝒜 (Submonoid.powers t)) := by
  constructor
  · rw [injective_iff_map_eq_zero]
    intro a ha
    have hval := congrArg HomogeneousLocalization.val ha
    rw [HomogeneousLocalization.val_zero] at hval
    change Localization.mk (a : A) ⟨1, one_mem _⟩ = 0 at hval
    rw [Localization.mk_eq_mk', IsLocalization.mk'_eq_zero_iff] at hval
    obtain ⟨⟨_, k, rfl⟩, hk⟩ := hval
    refine Subtype.ext (eq_zero_of_mul_pow_eq_zero_of_degreeOne_generator 𝒜 ht hinj k a a.2 ?_)
    rw [mul_comm]; exact hk
  · intro y
    obtain ⟨n, a, ha, rfl⟩ := Away.mk_surjective 𝒜 ht y
    have ha' : a ∈ 𝒜 n := by simpa using ha
    obtain ⟨x, hx, rfl⟩ := exists_mul_pow_eq_of_mem_of_degreeOne_generator 𝒜 hsurj n a ha'
    refine ⟨⟨x, hx⟩, ?_⟩
    apply HomogeneousLocalization.val_injective
    rw [Away.val_mk]
    change Localization.mk x ⟨1, one_mem _⟩ = _
    rw [Localization.mk_eq_mk_iff, Localization.r_iff_exists]
    exact ⟨1, by simp [mul_comm]⟩

/-- **Stacks 01MI, abstract form.** If `t ∈ 𝒜 1` and multiplication by `t` is a bijection
`𝒜 n → 𝒜 (n+1)` for every `n` (so `𝒜 = 𝒜₀[t]`), then `Proj.toSpecZero 𝒜 : Proj 𝒜 ⟶ Spec 𝒜₀` is
an isomorphism. Proof: `D₊(t) = Proj 𝒜` and `(𝒜_t)₀ = 𝒜₀`; see the module docstring. -/
theorem isIso_toSpecZero_of_degreeOne_generator (ht : t ∈ 𝒜 1)
    (hinj : ∀ (n : ℕ) (x : A), x ∈ 𝒜 n → x * t = 0 → x = 0)
    (hsurj : ∀ (n : ℕ) (y : A), y ∈ 𝒜 (n + 1) → ∃ x ∈ 𝒜 n, x * t = y) :
    IsIso (Proj.toSpecZero 𝒜) := by
  have := isIso_awayι_of_degreeOne_generator 𝒜 ht hsurj
  have : IsIso (CommRingCat.ofHom (fromZeroRingHom 𝒜 (Submonoid.powers t))) :=
    (ConcreteCategory.isIso_iff_bijective _).mpr
      (fromZeroRingHom_bijective_of_degreeOne_generator 𝒜 ht hinj hsurj)
  have h := Proj.awayι_toSpecZero 𝒜 t ht one_pos
  have : IsIso (Proj.awayι 𝒜 t ht one_pos ≫ Proj.toSpecZero 𝒜) := by rw [h]; infer_instance
  exact IsIso.of_isIso_comp_left (Proj.awayι 𝒜 t ht one_pos) (Proj.toSpecZero 𝒜)

end AlgebraicGeometry.Proj

end
