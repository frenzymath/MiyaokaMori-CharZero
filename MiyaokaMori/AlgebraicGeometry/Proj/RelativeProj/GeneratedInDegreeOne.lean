import MiyaokaMori.Prelude
import MiyaokaMori.AlgebraicGeometry.Modules.Tensor.ModulesTensorMonoidalIso
import MiyaokaMori.AlgebraicGeometry.Proj.RelativeProj.GradedQuasicoherentAlgebra
import MiyaokaMori.AlgebraicGeometry.Modules.Basic.ModulesEpiOfOpenCover
import MiyaokaMori.AlgebraicGeometry.Modules.Tensor.ModulesTensorPower
import MiyaokaMori.AlgebraicGeometry.Modules.Tensor.SheafOfModulesMonoidal

/-! # Graded algebra sheaves generated in degree one

The predicate "the graded quasi-coherent algebra sheaf `S` is generated by its degree-one part";
it governs when `O(1)` is invertible and when `Proj` carries a relative polarization.

Source: Lemma 2.2 of the paper (the Veronese algebra is generated by
`S_m` as an `O_C`-algebra).
-/

set_option autoImplicit false
set_option maxHeartbeats 400000

universe u v w u' v'

open CategoryTheory CategoryTheory.Limits Opposite TopologicalSpace
open scoped AlgebraicGeometry

noncomputable section

open scoped CategoryTheory.MonoidalCategory

/-- Iterated multiplication `S_1^{⊗ℓ} → S_ℓ` (for `ℓ = 0` it is the unit `O_X → S_0`). The `(ℓ+1)`-st
tensor power is `Modules.tensor (tensorPow ℓ) S_1`; it is first identified with the monoidal `⊗` by the
canonical isomorphism and then composed with the right whiskering of `S.mul`. -/

noncomputable def AlgebraicGeometry.Scheme.GradedQCAlgebra.mulPowOne {X : AlgebraicGeometry.Scheme.{u}}
    (S : X.GradedQCAlgebra) : (ℓ : ℕ) →
    (AlgebraicGeometry.Scheme.Modules.tensorPow (S.part 1) ℓ ⟶ S.part ℓ)
  | 0 => S.one
  | ℓ + 1 =>
    (AlgebraicGeometry.Scheme.Modules.tensorIsoTensorObj
        (AlgebraicGeometry.Scheme.Modules.tensorPow (S.part 1) ℓ) (S.part 1)).hom ≫
      (AlgebraicGeometry.Scheme.GradedQCAlgebra.mulPowOne S ℓ ▷ S.part 1) ≫ S.mul ℓ 1

/-- Generated in degree one (over `S_0`): for every `ℓ ≥ 1`, the map `S_1^{⊗ℓ} → S_ℓ` is an epimorphism. -/

def AlgebraicGeometry.Scheme.GradedQCAlgebra.GeneratedInDegreeOne {X : AlgebraicGeometry.Scheme.{u}}
    (S : X.GradedQCAlgebra) : Prop :=
  ∀ ℓ : ℕ, 0 < ℓ → CategoryTheory.Epi (S.mulPowOne ℓ)

end
