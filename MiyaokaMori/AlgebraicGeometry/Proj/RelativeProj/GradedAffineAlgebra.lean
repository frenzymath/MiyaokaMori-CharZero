import MiyaokaMori.AlgebraicGeometry.Modules.Algebra.AffineAlgebra
import Mathlib.RingTheory.GradedAlgebra.RingHom
import Mathlib.RingTheory.GradedAlgebra.Basic

/-! # Graded affine algebras on a scheme

An **`ℕ`-graded quasi-coherent `O_X`-algebra** `X.GradedAffineAlgebra` on a scheme `X`: a quasi-coherent
algebra (`X.AffineAlgebra`, whose quasi-coherence is a field) together with an internal grading
`grading U : ℕ → AddSubgroup A(U)` (a `GradedRing` instance) of the sections ring `A(U)` over every affine open
`U`, such that the restriction maps preserve the grading and the structure map lands in degree `0`. Companion
notions: the graded restriction homomorphism `restrictGraded`, `unitZero : Γ(X,U) →+* A(U)_0`, the predicates
`IsConnected` (`S_0 = O_X`), `GeneratedInDegreeOne` (in the form of Stacks 01N0: `S(U)` is generated by `S_1(U)`
as an `S_0(U)`-algebra), `GeneratedInDegree d` and `SufficientlyDivisible`.

Design:
* The grading is an internal grading of a ring (Mathlib's `GradedRing`), so multiplication is the ring
  multiplication and no `eqToHom` transport of indices is needed; quasi-coherence is part of the structure. The
  grading is only required over affine opens (over a non-quasi-compact open the degrees of sections of a direct
  sum sheaf are unbounded). The relative Proj only uses the graded sections rings over affine opens anyway.
* `GeneratedInDegreeOne` follows Stacks 01N0 ("generated by `S_1` over `S_0`") rather than the stronger
  "generated by `S_1` over `O_X`"; when `S_0 ≠ O_X` the latter could make `SufficientlyDivisible` impossible.
  The condition `S_0 = O_X` is expressed separately by `IsConnected` (satisfied by jet algebras:
  `BasedJetAlgebra.grading_zero`).

Source: Stacks 01NM (the situation of the relative Proj), 01N0; the graded coordinate algebra `𝒮` of the jet
scheme in §2 of the paper.
-/

set_option autoImplicit false

universe u

open CategoryTheory Opposite

noncomputable section

namespace AlgebraicGeometry.Scheme

/-- An affine open `U` regarded as an object of the affine Zariski site (the two object types coincide; only the
order differs: `U ≤ V` in `AffineZariskiSite` means that `U` is a basic open of `V`).

Always pass through this `def` rather than the anonymous constructor `⟨U.1, U.2⟩`: the conclusion of
`instGradedRing` is `GradedRing (S.grading ?U)`, and instance search does not match `?U` against a `Subtype.mk`
(`GradedRing (S.grading ⟨U.1, U.2⟩)` fails to synthesize, while `S.grading (affineSite U)` works). -/
def affineSite {X : Scheme.{u}} (U : X.affineOpens) : X.AffineZariskiSite := ⟨U.1, U.2⟩

@[simp] theorem affineSite_toOpens {X : Scheme.{u}} (U : X.affineOpens) :
    (affineSite U).toOpens = U.1 := rfl


/-- An `ℕ`-graded quasi-coherent `O_X`-algebra on `X` (graded on the sections rings over affine opens). -/
structure GradedAffineAlgebra (X : Scheme.{u}) extends X.AffineAlgebra where
  /-- The degree-`m` piece of `A(U)`. -/
  grading : ∀ U : X.AffineZariskiSite, ℕ → AddSubgroup (ring.obj (op U))
  /-- The pieces form an internal grading of the ring. -/
  graded : ∀ U : X.AffineZariskiSite, GradedRing (grading U)
  /-- Restriction preserves the grading. -/
  restrict_mem : ∀ {U V : X.AffineZariskiSite} (h : U ≤ V) {m : ℕ} {a : ring.obj (op V)},
    a ∈ grading V m → (ring.map (homOfLE h).op).hom a ∈ grading U m
  /-- The structure map lands in degree `0`. -/
  unit_mem : ∀ (U : X.AffineZariskiSite) (r : Γ(X, U.toOpens)), (unit.app (op U)).hom r ∈ grading U 0

namespace GradedAffineAlgebra

variable {X : Scheme.{u}} (S : X.GradedAffineAlgebra)

instance instGradedRing (U : X.AffineZariskiSite) : GradedRing (S.grading U) := S.graded U

/-- The graded restriction homomorphism `S(V) → S(U)`. -/
def restrictGraded {U V : X.AffineZariskiSite} (h : U ≤ V) : S.grading V →+*ᵍ S.grading U where
  toRingHom := S.toAffineAlgebra.restrict h
  map_mem := S.restrict_mem h

@[simp] theorem restrictGraded_apply {U V : X.AffineZariskiSite} (h : U ≤ V)
    (a : S.toAffineAlgebra.sections V) :
    S.restrictGraded h a = S.toAffineAlgebra.restrict h a := rfl

theorem restrictGraded_refl (U : X.AffineZariskiSite) :
    S.restrictGraded (le_refl U) = GradedRingHom.id (S.grading U) :=
  GradedRingHom.ext fun a => S.toAffineAlgebra.restrict_refl U a

theorem restrictGraded_trans {U V W : X.AffineZariskiSite} (hUV : U ≤ V) (hVW : V ≤ W) :
    S.restrictGraded (hUV.trans hVW) = (S.restrictGraded hUV).comp (S.restrictGraded hVW) :=
  GradedRingHom.ext fun a => (S.toAffineAlgebra.restrict_restrict hUV hVW a).symm

/-- The structure map as a ring homomorphism `Γ(X,U) → S(U)_0` into the degree-`0` piece. -/
def unitZero (U : X.AffineZariskiSite) : Γ(X, U.toOpens) →+* S.grading U 0 where
  toFun r := ⟨S.toAffineAlgebra.unitHom U r, S.unit_mem U r⟩
  map_one' := Subtype.ext (map_one _)
  map_mul' a b := Subtype.ext (map_mul _ a b)
  map_zero' := Subtype.ext (map_zero _)
  map_add' a b := Subtype.ext (map_add _ a b)

@[simp] theorem coe_unitZero (U : X.AffineZariskiSite) (r : Γ(X, U.toOpens)) :
    (S.unitZero U r : S.toAffineAlgebra.sections U) = S.toAffineAlgebra.unitHom U r := rfl

/-- **`S_0 = O_X`**: the structure map `Γ(X,U) → S(U)_0` is bijective. Satisfied by jet algebras, symmetric
algebras and Rees-type algebras. -/
def IsConnected : Prop := ∀ U : X.AffineZariskiSite, Function.Bijective (S.unitZero U)

/-- The Veronese subalgebra `S^{(d)} = ⊕_m S_{dm}` is generated by `S_d` over `S_0`: every homogeneous element of
degree `dm` lies in the subring generated by `S(U)_0 ∪ S(U)_d`. For `d = 1` this is "`S` is generated by `S_1`
over `S_0`" of Stacks 01N0. -/
def GeneratedInDegree (d : ℕ) : Prop :=
  ∀ (U : X.AffineZariskiSite) (m : ℕ) (a : S.toAffineAlgebra.sections U), a ∈ S.grading U (d * m) →
    a ∈ Subring.closure ((S.grading U 0 : Set (S.toAffineAlgebra.sections U)) ∪ S.grading U d)

/-- The form of Stacks 01N0: `S` is generated by `S_1` over `S_0`. -/
def GeneratedInDegreeOne : Prop := S.GeneratedInDegree 1

/-- `m` is "sufficiently divisible": `m > 0` and the Veronese subalgebra `S^{(m)}` is generated by `S_m` over `S_0`
(then `O(m)` is invertible and relatively very ample; in the paper, `m = s_k · lcm(1..k)` and its positive
multiples, Lemma 2.2). -/
def SufficientlyDivisible (m : ℕ) : Prop := 0 < m ∧ S.GeneratedInDegree m

theorem SufficientlyDivisible.pos {m : ℕ} (h : S.SufficientlyDivisible m) : 0 < m := h.1

/-! ## Homomorphisms -/

/-- A homomorphism of graded algebras: a homomorphism of the underlying algebras preserving the grading over every
affine open. -/
@[ext] structure Hom (S T : X.GradedAffineAlgebra) extends
    AffineAlgebra.Hom S.toAffineAlgebra T.toAffineAlgebra where
  map_mem : ∀ (U : X.AffineZariskiSite) {m : ℕ} {a : S.toAffineAlgebra.sections U},
    a ∈ S.grading U m → (app.app (op U)).hom a ∈ T.grading U m

/-- The graded ring homomorphism on the components. -/
def Hom.appGraded {S T : X.GradedAffineAlgebra} (φ : Hom S T) (U : X.AffineZariskiSite) :
    S.grading U →+*ᵍ T.grading U where
  toRingHom := (φ.app.app (op U)).hom
  map_mem := φ.map_mem U

end GradedAffineAlgebra

end AlgebraicGeometry.Scheme

end
