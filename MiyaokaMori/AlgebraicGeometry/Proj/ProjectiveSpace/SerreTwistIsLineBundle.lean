import MiyaokaMori.Prelude
import MiyaokaMori.AlgebraicGeometry.Proj.ProjectiveSpace.ProjectiveSpace
import MiyaokaMori.AlgebraicGeometry.Modules.LineBundle.SheafOfModulesIsLineBundle
import MiyaokaMori.AlgebraicGeometry.Proj.ProjectiveSpace.ProjectiveSpaceCoordinate
import MiyaokaMori.AlgebraicGeometry.Proj.ProjectiveSpace.SerreTwistProjectiveSpace
import MiyaokaMori.AlgebraicGeometry.Proj.Twist.WeightedProjNegativeFrame

/-! # The Serre twists on `P^N` are line bundles

The Serre twisting sheaf `O(m)` on `P^N` is a line bundle: on the standard open `D_+(x_i)` it is
generated by `x_i^m`.

The proof has two layers:
* **General graded rings** (`Proj.twist_isLineBundle`): if the standard opens `D₊(g i)` of a family of
  degree-one homogeneous elements `g i` cover `Proj 𝒜`, then `O(m)` is a line bundle for every `m : ℤ`.
  Frames come from `ProjTwisting.exists_isFrame_sheaf_basicOpen`: `g ^ m` for `m ≥ 0`
  (`isFrame_homogeneousSection`) and `1 / g ^ (-m)` for `m < 0` (`isFrame_inverseSection`). A frame gives
  a local isomorphism with the structure sheaf through `Scheme.Modules.IsFrame.restrictIso`, which is fed
  to the constructor of `IsLineBundle`.
* **Projective space**: a single instantiation with `g i := X i`; the covering is
  `projectiveSpace_iSup_basicOpen_X`.
-/

set_option autoImplicit false
set_option maxHeartbeats 400000

universe u v w u' v'

open CategoryTheory CategoryTheory.Limits Opposite TopologicalSpace
open scoped AlgebraicGeometry

noncomputable section

attribute [local instance] MvPolynomial.gradedAlgebra

/-- **General graded rings**: let `g : ι → A` consist of degree-one homogeneous elements whose standard
opens `D₊(g i)` cover `Proj 𝒜`. Then for every `m : ℤ` the Serre twist `O(m)` is a line bundle.

Proof: every point lies in some `D₊(g i)`, and `O(m)` has a frame on `D₊(g i)`: `g i ^ m` for `m ≥ 0`
and `1 / g i ^ (-m)` for `m < 0` (`MiyaokaMori.WeightedJets.ProjTwisting.exists_isFrame_sheaf_basicOpen`). -/
theorem AlgebraicGeometry.Proj.twist_isLineBundle {σ A : Type u} [CommRing A] [SetLike σ A]
    [AddSubgroupClass σ A] (𝒜 : ℕ → σ) [GradedRing 𝒜] {ι : Type w} (g : ι → A)
    (hg : ∀ i, g i ∈ 𝒜 1)
    (hcover : ⨆ i, AlgebraicGeometry.Proj.basicOpen 𝒜 (g i) = ⊤) (m : ℤ) :
    (AlgebraicGeometry.Proj.twist 𝒜 m).IsLineBundle := by
  refine ⟨fun p ↦ ?_⟩
  obtain ⟨i, hi⟩ := TopologicalSpace.Opens.mem_iSup.mp (hcover.ge (Set.mem_univ p))
  obtain ⟨e, he⟩ :=
    MiyaokaMori.WeightedJets.ProjTwisting.exists_isFrame_sheaf_basicOpen 𝒜 m (g i) (hg i)
  exact ⟨_, hi, ⟨he.restrictIso⟩⟩

/-- The standard opens `D_+(x_i)` cover `P^N`: the `x_i` are homogeneous and generate the whole
polynomial ring over `k` (Mathlib's `Proj.iSup_basicOpen_eq_top'` applied to `projectiveGrading`;
`WeightedJets.weightedCoordinateOpen_iSup` is the weighted version of the same statement). -/
theorem projectiveSpace_iSup_basicOpen_X (k : Type u) [Field k] (N : ℕ) :
    ⨆ i : Fin (N + 1), AlgebraicGeometry.Proj.basicOpen (AlgebraicGeometry.Proj.projectiveGrading k N)
      (MvPolynomial.X i) = ⊤ := by
  apply AlgebraicGeometry.Proj.iSup_basicOpen_eq_top'
  · exact fun i ↦ ⟨1, MvPolynomial.isHomogeneous_X k i⟩
  · apply top_unique
    intro p hp
    clear hp
    induction p using MvPolynomial.induction_on with
    | C r =>
      exact (Algebra.adjoin (AlgebraicGeometry.Proj.projectiveGrading k N 0)
        (Set.range (MvPolynomial.X : Fin (N + 1) → MvPolynomial (Fin (N + 1)) k))).algebraMap_mem
          ⟨MvPolynomial.C r, MvPolynomial.isHomogeneous_C (Fin (N + 1)) r⟩
    | add p q hp hq => exact Subalgebra.add_mem _ hp hq
    | mul_X p i hp =>
      exact Subalgebra.mul_mem _ hp (Algebra.subset_adjoin (Set.mem_range_self i))

/- On the standard open `D_+(x_i)` the sheaf `O(m)` is trivialized by `x_i^m` (for `m ≥ 0` by
   `isFrame_homogeneousSection`, for `m < 0` by `isFrame_inverseSection` with frame `1/x_i^{-m}`), and
   the `D_+(x_i)` cover `P^N`. Together this is the general theorem above, instantiated once. -/

instance projectiveSpaceTwist_isLineBundle (k : Type u) [Field k] (N : ℕ) (m : ℤ) :
    (projectiveSpaceTwist k N m).IsLineBundle :=
  AlgebraicGeometry.Proj.twist_isLineBundle (AlgebraicGeometry.Proj.projectiveGrading k N)
    (fun i : Fin (N + 1) ↦ MvPolynomial.X i)
    (fun i ↦ MvPolynomial.isHomogeneous_X k i)
    (projectiveSpace_iSup_basicOpen_X k N) m

end
