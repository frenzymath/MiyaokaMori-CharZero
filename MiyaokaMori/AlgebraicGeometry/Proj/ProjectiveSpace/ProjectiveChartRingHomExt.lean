import MiyaokaMori.Prelude
import MiyaokaMori.AlgebraicGeometry.Proj.ProjectiveSpace.ProjectiveCoordinateRatio

/-! # Extensionality for ring homomorphisms out of a standard chart of `P^N_k`

The standard chart ring `k[X_0, …, X_N]_{(X_j)}` of `P^N_k` is generated by `k` and the ratios `X_i/X_j`:
two ring homomorphisms out of it that agree on `k` and on every `X_i/X_j` are equal.

Source: the proof of Hartshorne II Prop. 2.5 (`D_+(X_j) = Spec k[X_0/X_j, …, X_N/X_j]`).

Proof (fully formalized below). Write `𝒜 = projectiveGrading k N` (the total-degree grading on
`k[X_0,…,X_N]`) and `f = X_j ∈ 𝒜 1`. Mathlib's `HomogeneousLocalization.Away.adjoin_mk_prod_pow_eq_top`
says that `Away 𝒜 f` is generated as an `𝒜 0`-algebra by the fractions `(∏ X_i^{a_i}) / X_j^a` with
`∑ a_i = a` (take `v = X`, `dv = 1`; the hypothesis "`𝒜 0` and the `X_i` generate the polynomial ring"
is `adjoin_gradeZero_range_X` below, proved by `MvPolynomial.induction_on`). Each such fraction is the
monomial `∏ (X_i/X_j)^{a_i}` in the `ratioElement`s (`awayMk_prod_pow_eq_prod_ratioElement`, checked on
`val` in `Localization.Away (X_j)`), and `𝒜 0` consists of the constants `C c`
(`gradeZero_exists_algebraMap`: a homogeneous polynomial of degree 0 has total degree 0, hence is a
constant). So `Algebra.adjoin_induction` shows `ρ₁ x = ρ₂ x` for every `x`: on generators by `hX`
(and `map_prod`, `map_pow`), on `algebraMap (𝒜 0) _ r = fromZeroRingHom 𝒜 _ r` by `hk`, and the
sum/product cases by `map_add`/`map_mul`. -/

set_option autoImplicit false
set_option maxHeartbeats 400000

universe u v w u' v'

open CategoryTheory CategoryTheory.Limits Opposite TopologicalSpace
open scoped AlgebraicGeometry

noncomputable section

attribute [local instance] MvPolynomial.gradedAlgebra

namespace ProjectiveSpace

variable {k : Type u} [Field k] {N : ℕ}

/-- The polynomial ring `k[X_0,…,X_N]` is generated over its degree-zero part by the variables
(`MvPolynomial.induction_on`: constants lie in `𝒜 0`, and the class is closed under `+` and `· * X_i`). -/
theorem adjoin_gradeZero_range_X :
    Algebra.adjoin ((AlgebraicGeometry.Proj.projectiveGrading k N) 0)
      (Set.range (MvPolynomial.X : Fin (N + 1) → MvPolynomial (Fin (N + 1)) k)) = ⊤ := by
  rw [eq_top_iff]
  rintro p -
  induction p using MvPolynomial.induction_on with
  | C a =>
    have h : (MvPolynomial.C a : MvPolynomial (Fin (N + 1)) k) =
        algebraMap ((AlgebraicGeometry.Proj.projectiveGrading k N) 0) (MvPolynomial (Fin (N + 1)) k)
          ⟨MvPolynomial.C a, MvPolynomial.isHomogeneous_C _ a⟩ := rfl
    rw [h]
    exact Subalgebra.algebraMap_mem _ _
  | add p q hp hq => exact add_mem hp hq
  | mul_X p i hp => exact mul_mem hp (Algebra.subset_adjoin ⟨i, rfl⟩)

/-- Every element of the degree-zero part of `k[X_0,…,X_N]` is a constant from `k`
(a homogeneous polynomial of degree `0` has total degree `0`, hence equals `C (coeff 0)`). -/
theorem gradeZero_exists_algebraMap (r : (AlgebraicGeometry.Proj.projectiveGrading k N) 0) :
    ∃ c : k, algebraMap k ((AlgebraicGeometry.Proj.projectiveGrading k N) 0) c = r := by
  refine ⟨r.val.coeff 0, Subtype.ext ?_⟩
  change MvPolynomial.C (r.val.coeff 0) = r.val
  exact (MvPolynomial.totalDegree_eq_zero_iff_eq_C.mp
    ((MvPolynomial.totalDegree_zero_iff_isHomogeneous (Fin (N + 1))).mpr r.property)).symm

/-- The generator `(∏ᵢ X_i^{a_i}) / X_j^a` of the chart ring (with `∑ a_i = a`) is the monomial
`∏ᵢ (X_i/X_j)^{a_i}` in the coordinate ratios. Checked on `val` in `Localization.Away (X_j)`. -/
theorem awayMk_prod_pow_eq_prod_ratioElement (j : Fin (N + 1)) (a : ℕ) (ai : Fin (N + 1) → ℕ)
    (hsum : ∑ i, ai i = a)
    (h : (∏ i, MvPolynomial.X i ^ ai i : MvPolynomial (Fin (N + 1)) k) ∈
      (AlgebraicGeometry.Proj.projectiveGrading k N) (a • 1)) :
    HomogeneousLocalization.Away.mk (AlgebraicGeometry.Proj.projectiveGrading k N)
        (MvPolynomial.isHomogeneous_X k j) a (∏ i, MvPolynomial.X i ^ ai i) h =
      ∏ i, ProjectiveSpaceOverChart.ratioElement N i j ^ ai i := by
  apply (show Function.Injective (algebraMap
    (HomogeneousLocalization.Away (AlgebraicGeometry.Proj.projectiveGrading k N) (MvPolynomial.X j))
    (Localization.Away (MvPolynomial.X j : MvPolynomial (Fin (N + 1)) k)))
    from HomogeneousLocalization.val_injective _)
  simp only [map_prod, map_pow, HomogeneousLocalization.algebraMap_apply,
    ProjectiveSpaceOverChart.ratioElement, HomogeneousLocalization.Away.mk,
    HomogeneousLocalization.val_mk, Localization.mk_pow, Localization.mk_prod]
  congr 1
  exact Subtype.ext (by
    simp only [SubmonoidClass.coe_finsetProd, SubmonoidClass.coe_pow, pow_one,
      Finset.prod_pow_eq_pow_sum, hsum])

end ProjectiveSpace

/-- Two ring homomorphisms out of the standard chart ring `k[X]_{(X_j)}` agreeing on `k` and on all ratios
`X_i/X_j` are equal.

Proof. `HomogeneousLocalization.Away.adjoin_mk_prod_pow_eq_top` says that `Away 𝒜 f` is generated as an
`𝒜 0`-algebra by the fractions `∏ (v i)^{a i} / f^a`; take `v = X` (`ι' = Fin (N+1)`, `dv = 1`;
`MvPolynomial` is generated by the `X_i`, `ProjectiveSpace.adjoin_gradeZero_range_X`). Equality of degrees
forces every generator to be a monomial in the `ratioElement`s (`∏ (X_i/X_j)^{a_i}`,
`ProjectiveSpace.awayMk_prod_pow_eq_prod_ratioElement`), and `𝒜 0 = k` (homogeneous polynomials of degree `0`
are constants, `ProjectiveSpace.gradeZero_exists_algebraMap`). Conclude by `Algebra.adjoin_induction`. -/
theorem ProjectiveSpace.chartRingHom_ext {k : Type u} [Field k] {N : ℕ} {R : Type u} [CommRing R]
    (j : Fin (N + 1))
    (ρ₁ ρ₂ : HomogeneousLocalization.Away (AlgebraicGeometry.Proj.projectiveGrading k N)
      (MvPolynomial.X j : MvPolynomial (Fin (N + 1)) k) →+* R)
    (hk : ∀ c : k,
      ρ₁ (HomogeneousLocalization.fromZeroRingHom (AlgebraicGeometry.Proj.projectiveGrading k N) _
        (algebraMap k ((AlgebraicGeometry.Proj.projectiveGrading k N) 0) c)) =
      ρ₂ (HomogeneousLocalization.fromZeroRingHom (AlgebraicGeometry.Proj.projectiveGrading k N) _
        (algebraMap k ((AlgebraicGeometry.Proj.projectiveGrading k N) 0) c)))
    (hX : ∀ i, ρ₁ (ProjectiveSpaceOverChart.ratioElement N i j) =
      ρ₂ (ProjectiveSpaceOverChart.ratioElement N i j)) : ρ₁ = ρ₂ := by
  have htop := HomogeneousLocalization.Away.adjoin_mk_prod_pow_eq_top
    (𝒜 := AlgebraicGeometry.Proj.projectiveGrading k N) (MvPolynomial.isHomogeneous_X k j) (Fin (N + 1))
    MvPolynomial.X ProjectiveSpace.adjoin_gradeZero_range_X (fun _ => 1) (fun i => MvPolynomial.isHomogeneous_X k i)
  ext x
  have hx : x ∈ Algebra.adjoin ((AlgebraicGeometry.Proj.projectiveGrading k N) 0)
      { HomogeneousLocalization.Away.mk (AlgebraicGeometry.Proj.projectiveGrading k N)
          (MvPolynomial.isHomogeneous_X k j) a (∏ i, MvPolynomial.X i ^ ai i)
          (hai ▸ SetLike.prod_pow_mem_graded _ _ _ _ fun i _ ↦ MvPolynomial.isHomogeneous_X k i) |
        (a : ℕ) (ai : Fin (N + 1) → ℕ) (hai : ∑ i, ai i • (fun _ => 1) i = a • 1)
        (_ : ∀ i, ai i ≤ 1) } := by
    rw [htop]; trivial
  induction hx using Algebra.adjoin_induction with
  | mem y hy =>
    obtain ⟨a, ai, hai, -, rfl⟩ := hy
    rw [ProjectiveSpace.awayMk_prod_pow_eq_prod_ratioElement j a ai (by simpa using hai), map_prod, map_prod]
    exact Finset.prod_congr rfl fun i _ => by rw [map_pow, map_pow, hX i]
  | algebraMap r =>
    obtain ⟨c, rfl⟩ := ProjectiveSpace.gradeZero_exists_algebraMap r
    exact hk c
  | add x y _ _ hx hy => rw [map_add, map_add, hx, hy]
  | mul x y _ _ hx hy => rw [map_mul, map_mul, hx, hy]

end
