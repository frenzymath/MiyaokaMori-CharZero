import MiyaokaMori.Prelude
import MiyaokaMori.Paper.S2WeightedJets.Intersection.CoordinatePowerSection
import MiyaokaMori.AlgebraicGeometry.Modules.Algebra.WeightedSymSectionsRingEquivSym
import MiyaokaMori.AlgebraicGeometry.Modules.DualMapAdditiveBiproduct
import MiyaokaMori.RingTheory.WeightedSymGenIdeal
import MiyaokaMori.AlgebraicGeometry.Proj.Twist.RelativeProjEvaluationGermNotMem
import MiyaokaMori.AlgebraicGeometry.Proj.RelativeProj.Stacks01nqPointRestrict
import MiyaokaMori.AlgebraicGeometry.Modules.Dual.DualFrameOldSections
import MiyaokaMori.AlgebraicGeometry.Modules.TensorFrameGermCriterion
import MiyaokaMori.AlgebraicGeometry.Modules.FramePowIsFrame
import MiyaokaMori.AlgebraicGeometry.Proj.Twist.TwistPullbackPowLocal
